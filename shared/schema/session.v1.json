{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screentail.dev/schema/session.v1.json",
  "title": "Session",
  "description": "One captured remote-support session: timeline events, screenshots, transcript and, once drafted, the note. Used by the client store export, the bundle builder, fixtures and Review. Ordering uses ts_ms: monotonic milliseconds since the session started. Optional values are omitted rather than written as null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "started_at",
    "remote_tool",
    "partial_capture",
    "frames_purged_unredacted",
    "local_only",
    "events",
    "frames",
    "transcript"
  ],
  "properties": {
    "schema_version": { "const": "session.v1" },
    "session_id": { "type": "string", "minLength": 1 },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Wall-clock start with offset, for display only."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Active duration; absent while recording."
    },
    "remote_tool": { "$ref": "#/$defs/RemoteTool" },
    "partial_capture": {
      "type": "boolean",
      "description": "Capture started late or was interrupted (Spec S3 banner)."
    },
    "frames_purged_unredacted": {
      "type": "integer",
      "minimum": 0,
      "description": "Frames deleted at finalize because redaction didn't finish in time (INV-1)."
    },
    "local_only": { "type": "boolean", "description": "Local-only mode was on for this session (INV-8)." },
    "policy_version": { "type": "string", "description": "Tenant policy version in force (ST-047)." },
    "suggested_ticket": { "type": "string", "pattern": "^[0-9]{3,9}$", "description": "A ticket number read off the remote-support window's title or the clipboard when the session started (ST-077). Digits only, never the title or the clipboard; Review pre-selects it with a Suggested badge." },
    "events": { "type": "array", "items": { "$ref": "#/$defs/SessionEvent" } },
    "frames": { "type": "array", "items": { "$ref": "#/$defs/Frame" } },
    "transcript": { "type": "array", "items": { "$ref": "#/$defs/TranscriptSegment" } },
    "draft": { "$ref": "#/$defs/DraftNote" }
  },
  "$defs": {
    "TsMs": {
      "title": "TsMs",
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic milliseconds since the session started."
    },
    "RemoteTool": {
      "title": "RemoteTool",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/RemoteToolKind" },
        "client_version": { "type": "string", "description": "Remote-tool client version (ST-023)." }
      }
    },
    "RemoteToolKind": {
      "title": "RemoteToolKind",
      "enum": ["screenconnect", "rdp", "splashtop", "teamviewer", "anydesk", "browser", "other"]
    },
    "SessionEvent": {
      "title": "SessionEvent",
      "description": "One timeline event, discriminated by \"type\".",
      "oneOf": [
        { "$ref": "#/$defs/ClickEvent" },
        { "$ref": "#/$defs/TypingBurstEvent" },
        { "$ref": "#/$defs/ShortcutEvent" },
        { "$ref": "#/$defs/EnterEvent" },
        { "$ref": "#/$defs/FocusEvent" },
        { "$ref": "#/$defs/CaptureStateEvent" },
        { "$ref": "#/$defs/MarkerEvent" },
        { "$ref": "#/$defs/NarrationEvent" }
      ]
    },
    "ClickEvent": {
      "title": "ClickEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_ms", "x", "y", "button"],
      "properties": {
        "type": { "const": "click" },
        "ts_ms": { "$ref": "#/$defs/TsMs" },
        "x": { "type": "integer", "description": "Physical screen pixels; negative on monitors left of or above the primary." },
        "y": { "type": "integer" },
        "button": { "$ref": "#/$defs/MouseButton" },
        "frame_id": { "type": "string", "description": "Screenshot taken for this click; absent when debounced or out of scope." }
      }
    },
    "MouseButton": { "title": "MouseButton", "enum": ["left", "right", "middle"] },
    "TypingBurstEvent": {
      "title": "TypingBurstEvent",
      "description": "A run of typing. Counts only: no field can hold a key or character (INV-2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_ms", "char_count"],
      "properties": {
        "type": { "const": "typing_burst" },
        "ts_ms": { "$ref": "#/$defs/TsMs" },
        "char_count": { "type": "integer", "minimum": 1 }
      }
    },
    "ShortcutEvent": {
      "title": "ShortcutEvent",
      "description": "A modifier chord such as Ctrl+C. Which keys is never recorded (INV-2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_ms"],
      "properties": {
        "type": { "const": "shortcut" },
        "ts_ms": { "$ref": "#/$defs/TsMs" }
      }
    },
    "EnterEvent": {
      "title": "EnterEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_ms"],
      "properties": {
        "type": { "const": "enter" },
        "ts_ms": { "$ref": "#/$defs/TsMs" }
      }
    },
    "FocusEvent": {
      "title": "FocusEvent",
      "description": "Foreground window changed (ST-022). Window titles are content and not stored here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_ms", "process", "scope"],
      "properties": {
        "type": { "const": "focus" },
        "ts_ms": { "$ref": "#/$defs/TsMs" },
        "process": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/CaptureScope" }
      }
    },
    "CaptureScope": {
      "title": "CaptureScope",
      "description": "Whether a window is captured (INV-5).",
      "enum": ["remote_tool", "admin_tool", "out_of_scope", "excluded"]
    },
    "CaptureStateEvent": {
      "title": "CaptureStateEvent",
      "description": "Capture state changed (ST-020). Suppressed and paused intervals keep no frames or typing (INV-6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_ms", "state"],
      "properties": {
        "type": { "const": "capture_state" },
        "ts_ms": { "$ref": "#/$defs/TsMs" },
        "state": { "$ref": "#/$defs/CaptureState" },
        "reason": { "$ref": "#/$defs/CaptureStateReason" }
      }
    },
    "CaptureState": { "title": "CaptureState", "enum": ["recording", "paused", "suppressed", "finalizing"] },
    "CaptureStateReason": {
      "title": "CaptureStateReason",
      "enum": ["user", "password_field", "excluded_app", "elevated_window", "sensitive_context", "out_of_scope", "no_indicator"]
    },
    "MarkerEvent": {
      "title": "MarkerEvent",
      "description": "The technician marked a moment (Ctrl+Alt+M, ST-029).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_ms"],
      "properties": {
        "type": { "const": "marker" },
        "ts_ms": { "$ref": "#/$defs/TsMs" },
        "frame_id": { "type": "string" }
      }
    },
    "NarrationEvent": {
      "title": "NarrationEvent",
      "description": "Speech with no screenshot within 8 seconds, kept as standalone narration (ST-028).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_ms", "segment_id"],
      "properties": {
        "type": { "const": "narration" },
        "ts_ms": { "$ref": "#/$defs/TsMs" },
        "segment_id": { "type": "string", "minLength": 1 }
      }
    },
    "Frame": {
      "title": "Frame",
      "description": "A screenshot. It is stored with redaction_pending true, and only the redaction worker clears it; nothing reads a pending frame (INV-1). A pending frame has no OCR text and no redaction time; a redacted one always has a redaction time.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts_ms",
        "trigger",
        "image",
        "width",
        "height",
        "redaction_pending",
        "masked_regions",
        "sensitive_context",
        "excluded_by_user"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ts_ms": { "$ref": "#/$defs/TsMs" },
        "trigger": { "$ref": "#/$defs/FrameTrigger" },
        "image": { "type": "string", "minLength": 1, "description": "Image path relative to the session bundle, e.g. frames/f-0002.jpg." },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "cursor": { "$ref": "#/$defs/Point" },
        "redaction_pending": { "type": "boolean" },
        "redacted_at": { "type": "string", "format": "date-time" },
        "masked_regions": { "type": "array", "items": { "$ref": "#/$defs/MaskedRegion" } },
        "sensitive_context": {
          "type": "boolean",
          "description": "Login-screen heuristic fired; the frame is never sent or attached (ST-041, ST-060)."
        },
        "ocr_text": { "type": "string", "description": "Redacted OCR text, e.g. with [CARD]. Only present once redacted." },
        "excluded_by_user": { "type": "boolean", "description": "Excluded in Review; never attached on publish (ST-075)." }
      },
      "if": { "properties": { "redaction_pending": { "const": true } } },
      "then": { "properties": { "redacted_at": false, "ocr_text": false } },
      "else": { "properties": { "redacted_at": true }, "required": ["redacted_at"] }
    },
    "FrameTrigger": { "title": "FrameTrigger", "enum": ["click", "scene_change", "marker"] },
    "Point": {
      "title": "Point",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "MaskedRegion": {
      "title": "MaskedRegion",
      "description": "A masked rectangle in stored-image pixels.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "kind"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "kind": { "$ref": "#/$defs/MaskKind" }
      }
    },
    "MaskKind": {
      "title": "MaskKind",
      "enum": ["ssn", "card", "api_key", "password", "email", "custom_pattern", "sensitive_context", "user_blur"]
    },
    "TranscriptSegment": {
      "title": "TranscriptSegment",
      "description": "Transcribed speech, already scrubbed (e.g. [REDACTED]).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ts_ms", "end_ms", "speaker", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ts_ms": { "$ref": "#/$defs/TsMs" },
        "end_ms": { "$ref": "#/$defs/TsMs" },
        "speaker": { "$ref": "#/$defs/Speaker" },
        "text": { "type": "string" },
        "frame_id": { "type": "string", "description": "Nearest preceding screenshot within 8 seconds (ST-028)." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "Speaker": {
      "title": "Speaker",
      "description": "Only the technician's microphone is captured in v1 (INV-9). end_user is reserved for the v1.2 consent workflow (ST-123).",
      "enum": ["tech", "end_user"]
    },
    "DraftNote": {
      "title": "DraftNote",
      "description": "The drafted ticket note (ST-061), as shown and edited in Review (Spec S3).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "steps",
        "result",
        "follow_ups",
        "suggested_title",
        "suggested_time_minutes",
        "kb_candidate",
        "kb_reason",
        "source",
        "prompt_version"
      ],
      "properties": {
        "problem": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/DraftStep" } },
        "result": { "type": "string" },
        "follow_ups": { "type": "array", "items": { "type": "string" } },
        "suggested_title": { "type": "string" },
        "suggested_time_minutes": { "type": "integer", "minimum": 0 },
        "kb_candidate": { "type": "boolean" },
        "kb_reason": { "type": "string", "description": "Shown next to the KB toggle, e.g. \"Not a KB candidate: one-off fix\"." },
        "source": { "$ref": "#/$defs/DraftSource" },
        "prompt_version": { "type": "string", "minLength": 1 }
      }
    },
    "DraftStep": {
      "title": "DraftStep",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "confidence", "frame_refs"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/StepConfidence" },
        "confirmed": {
          "type": "boolean",
          "description": "The technician confirmed this step in Review (Alt+C) or edited its text, so the low-confidence marker no longer applies (Spec S3). Absent means false. confidence stays as the draft was produced: how a step was arrived at and whether a human has since checked it are different facts, and writing \"high\" here would erase the first to record the second."
        },
        "frame_refs": { "type": "array", "items": { "type": "string" } },
        "transcript_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "StepConfidence": {
      "title": "StepConfidence",
      "description": "low: inferred from the screen only; Review shows the ⚠ marker (Spec S3).",
      "enum": ["high", "low"]
    },
    "DraftSource": {
      "title": "DraftSource",
      "description": "local: drafted on the device; Review shows the Local draft banner.",
      "enum": ["cloud", "local"]
    }
  }
}
