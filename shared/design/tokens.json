{
  "$schema": "./tokens.schema.json",
  "version": "0.4.2",
  "source": "Build Plan/01-UX-Design-Spec.md \u00a72",
  "color": {
    "bg.base": {
      "dark": "#0B0F14",
      "light": "#F6F8FA",
      "use": "window background"
    },
    "bg.surface": {
      "dark": "#11161D",
      "light": "#FFFFFF",
      "use": "panes, cards"
    },
    "bg.raised": {
      "dark": "#171E27",
      "light": "#F0F3F6",
      "use": "inputs, hovered rows"
    },
    "border.subtle": {
      "dark": "#232C38",
      "light": "#D9E0E7",
      "use": "dividers"
    },
    "border.strong": {
      "dark": "#33404F",
      "light": "#B9C3CE",
      "use": "focused containers"
    },
    "text.primary": {
      "dark": "#E6EDF3",
      "light": "#0F1720",
      "use": "body"
    },
    "text.secondary": {
      "dark": "#9AA7B5",
      "light": "#4B5865",
      "use": "labels, meta"
    },
    "text.muted": {
      "dark": "#7D8B9F",
      "light": "#626D79",
      "use": "placeholders, timestamps"
    },
    "accent.primary": {
      "dark": "#4F8CFF",
      "light": "#2A64CC",
      "use": "primary buttons, links, focus ring"
    },
    "accent.primary.hover": {
      "dark": "#6BA1FF",
      "light": "#265DBF",
      "use": "hovered primary"
    },
    "state.recording": {
      "dark": "#EF4444",
      "light": "#DC2626",
      "use": "recording indicator, stop"
    },
    "state.paused": {
      "dark": "#F59E0B",
      "light": "#CF7206",
      "use": "paused / suppressed"
    },
    "state.scope": {
      "dark": "#8B5CF6",
      "light": "#7C3AED",
      "use": "out-of-scope, excluded"
    },
    "state.published": {
      "dark": "#22C55E",
      "light": "#159F48",
      "use": "success, published"
    },
    "state.offline": {
      "dark": "#94A3B8",
      "light": "#64748B",
      "use": "offline / pending"
    },
    "state.danger": {
      "dark": "#F87171",
      "light": "#DC2626",
      "use": "destructive actions"
    },
    "confidence.low": {
      "dark": "#FBBF24",
      "light": "#CF7206",
      "use": "low-confidence step marker"
    },
    "text.on-accent": {
      "dark": "#0B0F14",
      "light": "#FFFFFF",
      "use": "text on accent.primary (primary buttons); dark theme uses dark text on the bright accent"
    }
  },
  "contrast": {
    "minimum": 4.5,
    "text": [
      "text.primary",
      "text.secondary",
      "text.muted",
      "accent.primary"
    ],
    "backgrounds": [
      "bg.base",
      "bg.surface",
      "bg.raised"
    ],
    "pairs": [
      [
        "text.on-accent",
        "accent.primary"
      ],
      [
        "text.on-accent",
        "accent.primary.hover"
      ]
    ],
    "indicators": [
      "state.recording",
      "state.paused",
      "state.scope",
      "state.published",
      "state.offline",
      "state.danger",
      "confidence.low"
    ],
    "indicator_minimum": 3.0,
    "structural": [
      "border.subtle",
      "border.strong"
    ],
    "_note": "Every key in `color` must appear in text, backgrounds, indicators, structural, or in a `pairs` entry \u2014 ContrastTests enforces that, so a new token cannot be added without deciding what it is allowed to do.\n  text: held to `minimum` against every background.\n  indicators: held to `indicator_minimum`, WCAG's non-text bar, because Spec v0.4.2 confines them to a rule, a border, a dot or a glyph and never to body-size text.\n  structural: dividers and container outlines. Held only to being a different colour from the background, not to 3:1 \u2014 WCAG 1.4.11 applies to visuals that are the sole means of identifying a component or its state, and these are not: a control is identified by its own surface colour and its label, and the focus ring is accent.primary, which is in `text` and so held to 4.5:1.\n  pairs: a colour that only ever meets one specific other. text.on-accent is unreadable on anything but the accent, and accent.primary.hover is never a surface for anything else, so they are checked against each other rather than against every background."
  },
  "font": {
    "ui": "Inter, \"Segoe UI\", sans-serif",
    "mono": "\"JetBrains Mono\", Consolas, monospace"
  },
  "size": {
    "xs": 11,
    "sm": 12,
    "md": 13,
    "lg": 15,
    "xl": 20
  },
  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600
  },
  "lineheight": {
    "body": 1.45,
    "heading": 1.25
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32
  },
  "layout": {
    "pane-padding": 16,
    "control-padding-y": 8,
    "control-padding-x": 12,
    "row-height": 32,
    "control-height": 32,
    "hud-height": 44,
    "hit-target-min": 28,
    "hud-control": 32
  },
  "radius": {
    "control": 4,
    "card": 6,
    "pill": 999
  },
  "elevation": {
    "dark": {
      "none": "none",
      "raised": "0 4px 16px rgba(0,0,0,.45)"
    },
    "light": {
      "none": "0 1px 3px rgba(15,23,32,.08)",
      "raised": "0 1px 3px rgba(15,23,32,.08)"
    }
  },
  "motion": {
    "state-ms": 120,
    "pane-ms": 180,
    "easing": "ease-out"
  },
  "icon": {
    "control": 16,
    "nav": 20
  },
  "focus": {
    "width": 2,
    "color": "accent.primary"
  }
}
