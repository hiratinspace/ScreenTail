<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- ASP.NET Core minimal API: auth, tenants, policy, summarization broker, providers (ST-008 onward). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScreenTail.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Lets `dotnet user-secrets` hold the provider key and the signing key during development. They
         live in the user profile, outside the repository, so there is no file here to commit by mistake
         and no environment variable to remember to export each morning. The host reads them only in the
         Development environment, so nothing about a deployment changes (ST-063). -->
    <UserSecretsId>screentail-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ST-063: the prompt ships with the service, so a deployment cannot drift from the version its
         post-conditions were written against. -->
    <EmbeddedResource Include="..\..\..\research\prompts\note_v1.md" LogicalName="ScreenTail.Api.Prompts.note_v1.md" />
    <!-- ST-061: the character data DraftValidator reads text with, shared with research/prompts/checks.py.
         Embedded because the API runs with InvariantGlobalization, where string.Normalize does nothing
         to non-ASCII text, so the NFKC tables have to travel with the service. -->
    <EmbeddedResource Include="..\..\..\research\prompts\unicode-tables.json" LogicalName="ScreenTail.Api.Summarize.unicode-tables.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- SharedRulesTests compares DraftRules with research/prompts/shared-rules.json. The rules stay
         internal: they are the validator's ingredients, not an API. -->
    <InternalsVisibleTo Include="ScreenTail.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- A build-time tool: dotnet-ef reads it to create migrations. PrivateAssets keeps it out of the
         published image, where a design-time assembly is surface nobody asked for (2026-09-19 review). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
</Project>
