<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ScreenTail.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenTail.Api\ScreenTail.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The drafts both implementations of the note prompt's post-conditions must agree about. The
         research harness reads the same file from its own tests; embedding it means this suite does not
         depend on where the repository is checked out, and a case added on either side fails both. -->
    <EmbeddedResource Include="..\..\..\research\prompts\hardening-cases.json" LogicalName="ScreenTail.Api.Tests.hardening-cases.json" />
    <EmbeddedResource Include="..\..\..\shared\contracts\summarize-request.v1.json" LogicalName="ScreenTail.Api.Tests.summarize-request.v1.json" />
    <EmbeddedResource Include="..\..\..\shared\contracts\publish-request.v1.json" LogicalName="ScreenTail.Api.Tests.publish-request.v1.json" />
    <EmbeddedResource Include="..\..\..\shared\contracts\session-metric.v1.json" LogicalName="ScreenTail.Api.Tests.session-metric.v1.json" />
  </ItemGroup>
</Project>
