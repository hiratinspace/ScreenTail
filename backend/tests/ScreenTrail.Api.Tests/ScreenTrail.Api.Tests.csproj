<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ScreenTrail.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Pinned on its own for the pool fix; see Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenTrail.Api\ScreenTrail.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The drafts both implementations of the note prompt's post-conditions must agree about. The
         research harness reads the same file from its own tests; embedding it means this suite does not
         depend on where the repository is checked out, and a case added on either side fails both. -->
    <EmbeddedResource Include="..\..\..\research\prompts\hardening-cases.json" LogicalName="ScreenTrail.Api.Tests.hardening-cases.json" />
    <EmbeddedResource Include="..\..\..\research\prompts\shared-rules.json" LogicalName="ScreenTrail.Api.Tests.shared-rules.json" />
    <EmbeddedResource Include="..\..\..\research\prompts\differential-cases.json" LogicalName="ScreenTrail.Api.Tests.differential-cases.json" />
    <EmbeddedResource Include="..\..\..\research\prompts\agreement-cases.json.gz" LogicalName="ScreenTrail.Api.Tests.agreement-cases.json.gz" />
    <EmbeddedResource Include="..\..\..\shared\contracts\summarize-request.v1.json" LogicalName="ScreenTrail.Api.Tests.summarize-request.v1.json" />
    <EmbeddedResource Include="..\..\..\shared\contracts\summarize-response.v1.json" LogicalName="ScreenTrail.Api.Tests.summarize-response.v1.json" />
    <EmbeddedResource Include="..\..\..\shared\contracts\publish-request.v1.json" LogicalName="ScreenTrail.Api.Tests.publish-request.v1.json" />
    <EmbeddedResource Include="..\..\..\shared\contracts\session-metric.v1.json" LogicalName="ScreenTrail.Api.Tests.session-metric.v1.json" />
    <EmbeddedResource Include="..\..\..\shared\contracts\tenant-policy.v1.json" LogicalName="ScreenTrail.Api.Tests.tenant-policy.v1.json" />
    <EmbeddedResource Include="..\..\..\shared\contracts\invite-code.v1.json" LogicalName="ScreenTrail.Api.Tests.invite-code.v1.json" />
  </ItemGroup>
</Project>
