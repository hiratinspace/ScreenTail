# Compose's settings for deploy/compose.yaml (ST-007). Copy to .env (git ignores it) and fill in.
# Nothing here is a secret: keys and passwords are files in ./secrets, written by make-secrets.sh.
# docs/dev/deploy.md explains each step.

# OWNER DECISION: the name the admin is served at. Its DNS A record must point at this host, and ports
# 80 and 443 must reach it, for Caddy to obtain the certificate. A placeholder until then. No AAAA
# record: the proxy is published on IPv4 only (docs/dev/deploy.md, "What not to do").
SCREENTAIL_DOMAIN=admin.example.com

# OWNER STEP: the Google OAuth client id (a "Web application" client whose Authorized JavaScript origin
# is https://<SCREENTAIL_DOMAIN>). Not a secret. Empty switches owner sign-in off. Changing it means
# rebuilding the proxy image: docker compose build proxy && docker compose up -d.
ADMIN_GOOGLE_CLIENT_ID=

# The host's ports. Leave 80 and 443 for a real deployment: the certificate authority checks them.
SCREENTAIL_HTTP_PORT=80
SCREENTAIL_HTTPS_PORT=443

# The private network between the proxy and the API, and the proxy's fixed address on it, which the
# API trusts for X-Forwarded-For. Change all three together, and only if 172.30.80.0/28 is already in
# use on this host: the address must be inside the subnet and outside the dynamic range.
SCREENTAIL_EDGE_SUBNET=172.30.80.0/28
SCREENTAIL_EDGE_DYNAMIC_RANGE=172.30.80.8/29
SCREENTAIL_PROXY_IP=172.30.80.2

# Where the secret files and the API's settings are, if not beside compose.yaml.
SCREENTAIL_SECRETS_DIR=./secrets
SCREENTAIL_API_ENV=./api.env
