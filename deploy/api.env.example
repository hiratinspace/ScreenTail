# The API's settings that are not secret (ST-007). Copy to api.env (git ignores it) and fill in.
# A setting left out keeps the service's default; an empty value is not the same as leaving it out,
# so delete a line rather than blanking it. docs/dev/web-admin.md and backend/README.md list them all.
#
# NEVER here: Jwt__SigningKey, Vault__MasterKey, Summarization__ApiKey, ConnectionStrings__Postgres.
# They are files in ./secrets (make-secrets.sh), mounted under /run/secrets.
# NEVER here: ASPNETCORE_FORWARDEDHEADERS_ENABLED (the API refuses to start with it and a proxy listed),
# ForwardedHeaders__* and Admin__GoogleClientId (compose.yaml sets them from .env).

# OWNER STEP: the Google addresses that may create a tenant on their first sign-in. With none, nobody
# can sign up (existing owners still sign in). Add __1, __2, ... for more.
Admin__SignupAllowlist__0=owner@example.com

# OWNER DECISIONS (ADR-0009), shown with their defaults.
Admin__NewTenantSeats=5
Admin__SessionLifetime=08:00:00
Admin__SignInNonceLifetime=00:10:00
RateLimit__PermitLimit=10
RateLimit__Window=00:01:00

# The Windows installer's https:// address for "Download client". Leave the line out until one exists.
# Admin__ClientDownloadUrl=https://downloads.example.com/ScreenTail-setup.exe

# Drafting (backend/README.md, "Drafting"). The key is the file secrets/summarization-api-key; with it
# empty the service starts and answers drafts with 501 not_configured.
Summarization__Provider=gemini-flash
# Summarization__Model=gemini-3.6-flash
# Summarization__DailyCostCapUsd=10

# The ConnectWise integration's clientId (ours, from developer.connectwise.com; not a secret).
# ConnectWise__ClientId=

Logging__LogLevel__Default=Information
