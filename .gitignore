# OS
.DS_Store
Thumbs.db

# .NET
bin/
obj/
*.user
*.suo
.vs/
TestResults/
*.nupkg
# installer/build.ps1 writes the published payload, the packages and its downloads here (ST-112).
artifacts/

# Node
node_modules/
dist/
coverage/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Spike artifacts (models and run output are never committed)
spike/**/models/
spike/**/tessdata/
spike/**/out/
*.ggml
*.bin

# Secrets never belong in the repository (ST-063). The services read every credential from the
# environment and have no defaults, so nothing here is needed to run them — these patterns exist to
# catch the local settings file somebody adds in a hurry with a model provider's key in it.
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
*.env
.env
.env.*
secrets.json
