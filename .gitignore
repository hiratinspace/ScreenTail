# OS
.DS_Store
Thumbs.db
desktop.ini

# .NET
bin/
obj/
*.user
*.suo
.vs/
TestResults/
*.trx
*.coverage
coverage.cobertura.xml
*.nupkg
# An MSBuild binary log records every property and environment variable of the build, a key among them.
*.binlog
# launchSettings.json can carry environment variables, so it stays local like the settings files below.
launchSettings.json
# installer/build.ps1 writes the published payload, the packages and its downloads here (ST-112).
artifacts/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Leftovers from merges, and logs: the scripts write theirs outside the repository.
*.orig
*.rej
*.log

# Spike artifacts (models and run output are never committed)
spike/**/models/
spike/**/tessdata/
spike/**/out/
*.ggml
*.bin

# Secrets never belong in the repository (ST-063). The services read every credential from the
# environment and have no defaults, so nothing here is needed to run them: these patterns exist to
# catch the local settings file somebody adds in a hurry with a model provider's key in it.
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
*.env
.env
.env.*
secrets.json

# A deployment's secrets, written by deploy/make-secrets.sh (ST-007). Its .env and api.env are caught
# above.
deploy/secrets/
# A database dump written in the wrong place, and the local override that holds a rotation's second key.
deploy/*.dump
deploy/compose.override.yaml

# Signing material never belongs in the repository either. Builds sign through Azure Artifact Signing and
# Key Vault (ADR-0007, ADR-0008), so a certificate or key file here is one added by mistake.
*.pfx
*.p12
*.pem
*.key
*.snk

# Local databases: the capture store lives under the user's profile, and tests use their own.
*.db
*.sqlite
*.sqlite3

# Private notes stay on the machine they were written on. CLAUDE.local.md is the private CLAUDE.md.
*.local.md

# Claude Code: shared project settings may be committed, everything else in .claude is local state.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/skills/

# Generated knowledge graph (graphify), rebuilt locally and never published.
graphify-out/
