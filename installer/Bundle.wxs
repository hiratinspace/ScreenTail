<?xml version="1.0" encoding="utf-8"?>
<!--
  ScreenTail-Setup.exe (ST-112, ADR-0007): the Visual C++ runtime ScreenTail's speech needs, then
  ScreenTail.msi. For a machine that may not have the runtime, which is every fresh Windows install.
  An MSP that already deploys the runtime can deploy ScreenTail.msi on its own instead.

  Variables, all passed by build.ps1:
    Version        the product version, the same as the package's
    Msi            the built (and, when configured, signed) ScreenTail.msi
    VcRedist       Microsoft's vc_redist.x64.exe, the version pinned in tools.json, downloaded by
                   package.ps1 and checked against the pin's SHA-256 and version and to be Microsoft-signed
    VcRedistBuild  the pinned runtime's build number, so an older runtime already on the machine is upgraded
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="ScreenTail"
          Manufacturer="ScreenTail"
          Version="$(var.Version)"
          UpgradeCode="{B06B249C-CE0B-47AF-AD9E-C7FF7D00A4C0}">

    <!-- No setup window of its own: the runtime installs as a prerequisite with a small progress window,
         and then the package shows its own progress (with /quiet, nothing at all). The standard setup
         window would need licence terms to show, and ScreenTail has none to put there yet; ST-111's
         privacy policy link belongs in the product once it exists. -->
    <BootstrapperApplication>
      <bal:WixInternalUIBootstrapperApplication />
    </BootstrapperApplication>

    <util:RegistrySearch Id="VcRuntimeX64Installed"
                         Root="HKLM"
                         Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
                         Value="Installed"
                         Variable="VcRuntimeX64Installed"
                         Result="value"
                         Bitness="always64" />
    <util:RegistrySearch Id="VcRuntimeX64Build"
                         Root="HKLM"
                         Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
                         Value="Bld"
                         Variable="VcRuntimeX64Build"
                         Result="value"
                         Bitness="always64" />

    <Chain>
      <!-- Shared with other software, so permanent: uninstalling ScreenTail never takes it away. Skipped
           when the same or a newer build is already there; 1638 is the runtime's own "a newer version is
           installed", which is success here.

           3010 and 1641 are success too, and that is what keeps a silent install from restarting the
           machine. The runtime's installer answers 3010 when it replaced a runtime another program had
           loaded: the new files are in place at the next restart, and until then that program, and
           ScreenTail, run on the runtime that was there. The setup program's prerequisite step treats any
           restart a prerequisite reports as one to make at once: it stops before ScreenTail.msi, exits
           1641 with ScreenTail not installed, and with /quiet and no /norestart it restarts the machine
           without asking. So the restart is not passed on: ScreenTail installs, the exit code is the
           package's own, and the runtime's exit code stays in the log (the line "The process for
           package: VcRuntimeX64 exited with code"). The runtime's installer is told to write its own
           log next to the setup program's, so why it wanted a restart can be read there. -->
      <ExePackage Id="VcRuntimeX64"
                  SourceFile="$(var.VcRedist)"
                  DetectCondition="VcRuntimeX64Installed = 1 AND VcRuntimeX64Build &gt;= $(var.VcRedistBuild)"
                  InstallArguments="/install /quiet /norestart /log &quot;[WixBundleLog_VcRuntimeX64]&quot;"
                  Permanent="yes"
                  PerMachine="yes"
                  Vital="yes"
                  bal:PrereqPackage="yes">
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="3010" Behavior="success" />
        <ExitCode Value="1641" Behavior="success" />
      </ExePackage>

      <MsiPackage Id="ScreenTail" SourceFile="$(var.Msi)" />
    </Chain>
  </Bundle>
</Wix>
