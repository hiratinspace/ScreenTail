<?xml version="1.0" encoding="utf-8"?>
<!--
  ScreenTail's Windows Installer package (ST-112, ADR-0007). Built by installer/build.ps1 with WiX 5:
  never by hand, because the payload it harvests is the publish output that script checks first.

  Per machine, into Program Files: MSP tools (Intune, RMM agents) install as the system account, and
  Program Files is the folder an ordinary user cannot change, which is what the peer checks rely on.
  The service starts at every sign-in from the machine's Run key (ADR-0003). The UI starts on demand,
  from the Start menu, or at sign-in when the technician turns "Start UI at login" on in Settings.

  Variables, all passed by build.ps1:
    Version  the product version, the same one stamped into both executables (major.minor.build)
    Payload  the folder holding the published, checked and (when configured) signed files
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="ScreenTail"
           Manufacturer="ScreenTail"
           Version="$(var.Version)"
           UpgradeCode="{85199A85-ACAA-43AA-8CDC-BA38D3570929}"
           Scope="perMachine"
           Compressed="yes"
           Language="1033">

    <!-- The UpgradeCode above is how Windows recognises an older ScreenTail; it never changes
         (InstallerAuthoringTests holds it). An upgrade removes the old version completely before the new
         one is installed, and that removal is an uninstall with UPGRADINGPRODUCTCODE set, which is what
         keeps the user-data step below from running during it. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of ScreenTail is already installed. Uninstall it first to install this one." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Nothing to choose: there are no optional features. Repair stays, because it is how an MSP puts
         back a deleted file without uninstalling. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- ST-112. The service registers for Restart Manager's restart, so that another program's installer
         that closes it starts it again. ScreenTail's own package does not: an upgrade or an uninstall
         leaves the service down until the next sign-in, as ADR-0007 says, and Windows Installer's restart
         would otherwise start the new service from the installer's own, elevated, process. -->
    <Property Id="MSIDISABLERMRESTART" Value="1" />

    <!-- And Windows Installer's Restart Manager asks only programs registered for restart to close, which
         ScreenTail's service is, and if anything holding an installed file is not, it asks nobody: a
         virus scanner, an endpoint agent or the CI runner's monitor reading the executable at that moment
         is never asked to close by ScreenTail's installer. Whatever is not asked is ended as before (the
         close steps below, and the uninstall step). -->
    <Property Id="MSIRMSHUTDOWN" Value="2" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!-- Whisper's native libraries need the Visual C++ 2015-2022 x64 runtime, which a fresh Windows does
         not have. Installing without it would put a service on the machine whose speech fails at the
         first session, so the package says so instead. ScreenTail-Setup.exe installs the runtime first;
         an MSP deploying this package on its own deploys the runtime before it. Never a reason to refuse
         an uninstall or a repair. -->
    <Property Id="VCRUNTIMEX64">
      <RegistrySearch Id="VcRuntimeX64Installed"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
                      Name="Installed"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR VCRUNTIMEX64 = &quot;#1&quot;"
            Message="ScreenTail needs the Microsoft Visual C++ 2015-2022 Redistributable (x64). Install it first, or install ScreenTail with ScreenTail-Setup.exe, which includes it." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ScreenTail" />
    </StandardDirectory>

    <!-- Only ever C:\Program Files\ScreenTail (or wherever this machine's 64-bit Program Files is).
         INSTALLFOLDER is a public property, so a command line could otherwise put ScreenTail in a folder
         ordinary users can change, and the uninstall would run the service from there as the system
         account. The expected folder comes from the environment, not from a property the same command
         line could set. Checked once the folders are resolved, in both sequences, so a silent install
         refuses too. -->
    <SetProperty Id="EXPECTEDINSTALLFOLDER" Value="[%ProgramW6432]\ScreenTail\" Before="CostInitialize" Sequence="both" />
    <CustomAction Id="RefuseInstallFolder"
                  Error="ScreenTail installs only into its folder under Program Files. Remove INSTALLFOLDER from the command line and install again." />
    <InstallUISequence>
      <Custom Action="RefuseInstallFolder" After="CostFinalize" Condition="NOT Installed AND INSTALLFOLDER ~&lt;&gt; EXPECTEDINSTALLFOLDER" />
    </InstallUISequence>

    <!-- Everything the publish produced, as it is laid out: both executables side by side at the top,
         which the development rule of the peer checks needs while builds are unsigned (ADR-0003), the
         native libraries beside them, and the registry files the service reads. -->
    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="$(var.Payload)\**" />
    </ComponentGroup>

    <!-- ADR-0003: the service starts at sign-in from a Run key, inside the user's own session, where
         hooks and capture work. The machine's key, so it starts for whoever signs in. The value's name
         is the development helper's (LoginStartup.ServiceValueName). -->
    <Component Id="ServiceAtSignIn" Directory="INSTALLFOLDER" Guid="{A76EDE4A-0847-4A9D-B9B2-7295633443BC}">
      <RegistryValue Root="HKLM"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="ScreenTail.Service"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]ScreenTail.Service.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{343F2DE9-FFC0-40FC-BCBF-5364C20CBE67}">
        <Shortcut Id="UiShortcut"
                  Name="ScreenTail"
                  Description="ScreenTail: session notes from remote support"
                  Target="[INSTALLFOLDER]ScreenTail.UI.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\ScreenTail" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="ScreenTail" Title="ScreenTail">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="ServiceAtSignIn" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- A running executable can be neither replaced nor removed. On an upgrade or an uninstall, and on
         nothing else, these end every running copy, in every session when the installer runs as the
         system account, as MSP tools run it. Ended, not asked: the UI answers a close by asking whether
         to stop a recording, and nobody is there to answer a silent install. After an upgrade the service
         is down until the next sign-in, and a session that was recording is recovered at that start
         (ST-020). A first install has nothing to close, and a repair must not end a recording.

         When they run matters. WiX schedules the closing step just before InstallFiles, which is after
         RemoveFiles: on an uninstall, and in the old version's own removal during an upgrade, it runs
         once the files have already been removed (the logs of 2026-11-01 show the order), so it does not
         close anything for the removal. What ends running copies before files are removed is Windows
         Installer's Restart Manager, in InstallValidate (it closed the old service in the upgrade logs),
         and, on an uninstall, the uninstall step below, which stops every installed copy before RemoveFiles
         (UninstallCleanup). These still end a copy that is running when new files are about to be
         installed. Whether to move them earlier is the owner's decision (#247). -->
    <util:CloseApplication Id="CloseService"
                           Target="ScreenTail.Service.exe"
                           CloseMessage="no"
                           EndSessionMessage="no"
                           RebootPrompt="no"
                           TerminateProcess="1"
                           Condition="WIX_UPGRADE_DETECTED OR REMOVE~=&quot;ALL&quot;" />
    <util:CloseApplication Id="CloseUi"
                           Target="ScreenTail.UI.exe"
                           CloseMessage="no"
                           EndSessionMessage="no"
                           RebootPrompt="no"
                           TerminateProcess="1"
                           Condition="WIX_UPGRADE_DETECTED OR REMOVE~=&quot;ALL&quot;" />

    <!-- INV-12 and the ticket. Windows Installer removes what it installed; this clears what ScreenTail
         made afterwards for each user: the data folder (the store, its key, the device's token) and the
         UI's own Run value. The installed service does it in its uninstall mode, run as the system
         account before the files go. It deletes a user's folder only while that user is signed in, under
         their own token. For every other user it removes only the store's key and the device's
         credentials, through handles that refuse links, so the store left behind cannot be read. It says
         how many of each in this log (WixQuietExec writes the program's output into it). Only for an uninstall: never during the
         uninstall step of an upgrade, which would erase every technician's sessions. Its result is
         ignored, so a folder that cannot be removed does not leave the product half uninstalled. Its last act
         is to wait until no other program (a scanner reading the executable) has an installed file open,
         two clean looks apart, because RemoveFiles straight after it would otherwise leave that file for a
         restart and end with 3010. The wait gets what is left of a 45-second deadline from the step's
         start, at most 15 seconds, so the step ends inside the minute WixQuietExec waits for it
         (ProgramFilesRelease). -->
    <SetProperty Id="RemoveUserData"
                 Value="&quot;[INSTALLFOLDER]ScreenTail.Service.exe&quot; --uninstall-cleanup"
                 Before="RemoveUserData"
                 Sequence="execute"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="RemoveUserData"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RefuseInstallFolder" After="CostFinalize" Condition="NOT Installed AND INSTALLFOLDER ~&lt;&gt; EXPECTEDINSTALLFOLDER" />
      <Custom Action="RemoveUserData" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
