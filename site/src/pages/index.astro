---
/**
 * The home page, ported from the approved draft (artifact 740bacdb). The copy is held to the product as
 * built (docs/STATUS.md, checked 2026-11-18): no absolute redaction claims, no results before the pilot,
 * and the owner connects the PSA. Animated parts are drawn by src/scripts/home.ts; without it the page is
 * complete and still.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MaskBand from '../components/MaskBand.astro';
import '../styles/home.css';
import glyphLight from '../assets/brand/glyph-small-light.svg';
import glyphDark from '../assets/brand/glyph-small-dark.svg';
import review from '../assets/screens/shell-review-light.png';
import published from '../assets/screens/shell-review-published-light.png';
import history from '../assets/screens/shell-history-light.png';
import tray from '../assets/screens/tray-menu-recording-light.png';
import panel from '../assets/screens/panel-light.png';
import { site } from '../site.config';
import { choices, limits } from '../../worker/pilot';

// The pinned scene's wall: a week of 46 sessions. Red tiles are the notes that never got written.
const bad: Record<number, [string, string]> = {
  4: ['Note', '"Fixed it."'],
  9: ['No time entry', '0:40 not billed'],
  15: ['Written later', '6 h after the call'],
  20: ['Screenshot', 'password visible'],
  26: ['No note', 'fix lives in one head'],
  31: ['Note', '"Rebooted, ok now."'],
  37: ['No time entry', '1:15 not billed'],
  42: ['No note', 'escalated blind'],
};
const widths = ['w2','w1','w3','w2','w4','w1','w2','w3','w1','w4','w2','w3','w1','w2','w3','w4','w1','w2','w2','w3','w4','w1','w3','w2','w1','w2','w4','w3','w1','w2','w3','w1','w4','w2','w3','w1','w2','w4','w2','w1','w3','w2','w4','w1','w3','w2'];
const tiles = widths.map((w, i) => {
  const b = bad[i];
  return {
    cls: b ? 'w4 bad' : w,
    id: `#${48170 + i * 7}`,
    bad: b,
    time: `${(i % 5) + 1}:${String((i * 13) % 60).padStart(2, '0')}`,
    r: (((i * 37) % 46) / 46).toFixed(3),
  };
});
---
<Base title={site.name}>
  <div class="clockpill" id="clockpill" data-s="rec" role="presentation">
    <span class="st" aria-hidden="true"><span class="sig"></span><span id="cp-label">Recording</span><span class="clk" id="cp-clock">00:00</span></span>
    <a href="#session" aria-label="Go to the session, start to ticket"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg></a>
    <a href="#pilot" aria-label="Go to the note this page wrote"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2"/></svg></a>
  </div>

  <section class="hero" data-pill="rec" aria-labelledby="h-hero">
    <div class="fig f1" aria-hidden="true"><canvas data-draw="windows"></canvas><span class="tag">#48213 · window</span></div>
    <div class="fig f2" aria-hidden="true"><canvas data-draw="voice"></canvas><span class="tag">14:02:11 · voice</span></div>
    <div class="fig f3" aria-hidden="true"><canvas data-draw="ribbon"></canvas><span class="tag">mark · drafting</span></div>
    <div class="fig f4" aria-hidden="true"><canvas data-draw="frames"></canvas><span class="tag">frames · 3 of 3</span></div>
    <div class="fig f5" aria-hidden="true"><canvas data-draw="mask"></canvas><span class="tag">2 masked</span></div>
    <div class="fig f6" aria-hidden="true"><canvas data-draw="clicks"></canvas><span class="tag">clicks</span></div>

    <div class="hero-copy">
      <span class="stage"><img src={glyphLight.src} alt="" width="16" height="16" />In development · looking for pilot MSPs</span>
      <h1 id="h-hero">Fix the problem. <span>The note is already written.</span></h1>
      <p class="sub">ScreenTrail follows a technician's remote session on their PC, masks the passwords and keys it reads on screen before anything is stored, and has the note, the time entry and the KB article drafted when the session ends.</p>
      <div class="actions">
        <a class="btn btn-dark" href="#pilot">Become a pilot MSP</a>
        <a class="btn btn-line" href="#how">See how it works</a>
      </div>
    </div>
    <div class="hero-figs" aria-hidden="true">
      <div class="fig"><canvas data-draw="ribbon"></canvas><span class="tag">mark · drafting</span></div>
      <div class="fig"><canvas data-draw="voice"></canvas><span class="tag">14:02:11 · voice</span></div>
    </div>
  </section>

  <section class="scene" id="scene" data-pill="rec" aria-labelledby="h-scene">
    <div class="scene-pin">
      <div class="wrap scene-copy">
        <div class="cap on" data-cap="0"><h2 id="h-scene">Remote sessions end. The notes don't get written.</h2><p class="sub">A technician works thirty remote sessions a week. Notes get typed from memory at the end of the day, or not at all.</p></div>
        <div class="cap" data-cap="1"><p class="h2-like"><strong>With ScreenTrail, every session gets its note.</strong></p><p class="sub">Each draft is built from what was on screen and what the technician said, ready when the session ends.</p></div>
        <div class="cap" data-cap="2"><p class="h2-like"><strong>Each one is a real ticket note.</strong></p><p class="sub">Problem, steps and result, each step beside the screenshot it happened on.</p></div>
        <div class="cap" data-cap="3"><p class="h2-like"><strong>Checked by a person, published in one press.</strong></p><p class="sub">The note and time entry go to ConnectWise, the article to Hudu.</p></div>
        <p class="tally" aria-hidden="true">Notes written this week <b id="tally">38</b> <span>of 46</span></p>
      </div>
      <div class="scene-stage" id="stage" aria-hidden="true">
        <div class="wall" id="wall">
          {tiles.map((t) => (
            <div class={`tile ${t.cls}`} data-r={t.r}>
              <span class="a">{t.bad ? (<><span class="k">{t.bad[0]}</span><b>{t.bad[1]}</b></>) : (<><span>{t.id}</span><span>{t.time}</span></>)}</span>
              <span class="b"><span>{t.id}</span><span class="st"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>{t.bad ? 'Published · note + time' : 'Published'}</span></span>
            </div>
          ))}
        </div>
        <article class="scene-note" id="scene-note">
          <div class="sn-head"><span class="chip"><b>#48213</b> Printer offline · Acme Dental</span><span class="chip on">Internal note</span><span class="chip">Time <b>15</b> min</span></div>
          <div class="sn-body note">
            <h3>Problem</h3>
            <div class="ln"><span></span><span>Nothing would print from the reception workstation; jobs sat in the queue.</span><span></span></div>
            <h3>Steps</h3>
            <div class="ln"><span>1.</span><span>Found the Print Spooler service stopped.</span><span class="shot"></span></div>
            <div class="ln"><span>2.</span><span>Started the service and set it to restart automatically on failure.</span><span class="shot"></span></div>
            <div class="ln"><span>3.</span><span>Cleared the stuck queue and printed a test page.</span><span class="shot"></span></div>
            <h3>Result</h3>
            <div class="ln"><span></span><span>Printing works again from the reception PC.</span><span></span></div>
          </div>
          <div class="sn-stamp"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3 3 7-7"/></svg>Published to ticket #48213 · note, time entry, KB article</div>
        </article>
      </div>
      <p class="wall-note">An illustration of a week of sessions, not measured data.</p>
    </div>
  </section>

  <MaskBand label="masked before it is kept" />

  <section class="session wrap" data-pill="rec" id="session" aria-labelledby="h-session">
    <h2 id="h-session">One session, start to ticket.</h2>
    <p class="sub mt">Ten minutes on a stuck print queue at Acme Dental. Everything ScreenTrail keeps is tied to the moment it happened, and threads through to the note.</p>
    <div class="events-box" id="events">
    <svg class="ribbon" id="ribbon" aria-hidden="true"></svg>
    <ol class="events">
      <li class="ev"><span class="knot"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="4" fill="#FF6B6B"/></svg>13:54</span><h3>Recording starts</h3><p>The ScreenConnect window comes forward, and its title is matched to ticket #48213.</p></li>
      <li class="ev"><span class="knot"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5.5" y="1.5" width="5" height="8" rx="2.5"/><path d="M3 8a5 5 0 0 0 10 0M8 13v2"/></svg>13:58</span><h3>You talk it through</h3><p><q>Nothing will print from reception.</q> Transcribed on the PC.</p></li>
      <li class="ev"><span class="knot"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M3 2l9 5-4 1.2L6.5 13z"/></svg>14:01</span><h3>Clicks are logged</h3><p>Services, then Print Spooler: each click with the window it landed in.</p></li>
      <li class="ev"><span class="knot"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="2"/><circle cx="8" cy="8" r="2.3"/></svg>14:02</span><h3>A frame is kept</h3><p>The screen showing the stopped service, masked, becomes screenshot 1.</p></li>
      <li class="ev"><span class="knot"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 14.5V2M3.5 2h8l-1.6 3 1.6 3h-8"/></svg>14:03</span><h3>You mark a moment</h3><p><kbd>Ctrl+Alt+M</kbd> flags the restart-on-failure change as worth a step.</p></li>
      <li class="ev"><span class="knot"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="4" width="8" height="8" rx="1.5" fill="currentColor"/></svg>14:04</span><h3>Stop and draft</h3><p><kbd>Ctrl+Alt+S</kbd> ends it after ten minutes. The draft, with Problem, Steps, Result and Follow-ups, is waiting.</p></li>
      <li class="ev"><span class="knot"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8"/></svg>14:20</span><h3>You check it</h3><p>Three steps confirmed, the one flagged step looked at, the time rounded up to 15 minutes.</p></li>
      <li class="ev end"><span class="knot"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 7.5l13-5.5-4 12-3-4.5zM7.5 9.5l7-7.5"/></svg>14:24</span><h3>Published</h3><p>Note and time entry in ConnectWise, the KB article in Hudu. Only because you chose to.</p></li>
    </ol>
    </div>
  </section>

  <section class="stages wrap" id="how" aria-labelledby="h-how">
    <h2 id="h-how" class="visually-hidden">How it works</h2>

    <article class="feature" data-pill="rec" aria-labelledby="h-f1">
      <div class="copy">
        <h3 id="h-f1">Capture starts with the remote tool.</h3>
        <p>Bring a ScreenConnect or Remote Desktop window to the front and the pill appears. Every click, every screen change and every spoken line goes onto one timeline. Switch to email and the screenshots stop until the remote tool is back in front.</p>
        <dl class="points">
          <div><dt>Keys</dt><dd><kbd>Ctrl+Alt+P</kbd> pause, <kbd>Ctrl+Alt+S</kbd> stop and draft, <kbd>Ctrl+Alt+M</kbd> mark a moment</dd></div>
          <div><dt>By hand</dt><dd><kbd>Ctrl+Alt+R</kbd> or Start capture in the tray, when a session didn't start on its own</dd></div>
          <div><dt>Scope</dt><dd>The remote tool's windows only, plus admin tools if you allow them</dd></div>
          <div><dt>Voice</dt><dd>The technician's microphone, transcribed on the PC</dd></div>
        </dl>
      </div>
      <div class="mock" data-replay aria-hidden="true">
        <div class="mock-bar"><span>session · ScreenConnect · #48213</span><span class="pill"><i class="dot"></i>Recording <span class="tm" data-clock>02:17</span></span></div>
        <ol class="mock-body tl">
          <li class="tl-row i0"><time>14:01:58</time><span class="kind click">click</span><span class="what">Start · Services</span></li>
          <li class="tl-row i1"><time>14:02:06</time><span class="kind frame">frame</span><span class="what">Screen changed · screenshot 1</span></li>
          <li class="tl-row i2"><time>14:02:11</time><span class="kind said">said</span><span class="what"><q>Spooler service is stopped, that's why nothing is printing.</q></span></li>
          <li class="tl-row i3"><time>14:02:40</time><span class="kind click">click</span><span class="what">Print Spooler · Restart</span></li>
          <li class="tl-row i4"><time>14:03:02</time><span class="kind said">said</span><span class="what"><q>Started it again and set it to restart on failure.</q></span></li>
          <li class="tl-row i5"><time>14:03:03</time><span class="kind mark">mark</span><span class="what">Moment marked · screenshot 2</span></li>
          <li class="tl-row i6"><time>14:04:15</time><span class="kind frame">frame</span><span class="what">Test page printed · screenshot 3</span></li>
        </ol>
        <div class="progress"><i class="on"></i><i></i><i></i><i></i></div>
      </div>
    </article>

    <article class="feature" data-pill="paused" aria-labelledby="h-f2">
      <div class="copy">
        <h3 id="h-f2">Secrets are masked before anything is kept.</h3>
        <p>When a password field has focus, capture pauses and the pill says so. Every screenshot is read on the PC, and the passwords, card numbers and keys it finds are painted out before the frame is stored or sent.</p>
        <dl class="points">
          <div><dt>Where</dt><dd>On the technician's PC, before storage and before sending</dd></div>
          <div><dt>Check</dt><dd>The draft says how many items were masked, so they can be checked</dd></div>
          <div><dt>Exclude</dt><dd>Apps on the exclusion list are not captured at all</dd></div>
        </dl>
      </div>
      <div class="mock" data-replay aria-hidden="true">
        <div class="mock-bar"><span>screenshot 2 · before it is stored</span><span class="pill"><i class="pz"></i>Paused: sensitive field</span></div>
        <div class="mock-body">
          <div class="remote">
            <div class="rt"><span>Remote session · RECEPTION-PC</span><span>notepad · printer-setup.txt</span></div>
            <div class="ln">Printer: HP LaserJet M404 · queue: Reception</div>
            <div class="ln">Wi-Fi key: <span class="secret i0">Gr33nT3a-Lobby!26</span></div>
            <div class="ln">Portal login: admin / <span class="secret i1">Spr1ng-Board-7731</span></div>
            <div class="ln">Driver: v5.2.1 · reinstall if the queue jams</div>
            <div class="field"><span>Admin password</span><span>capture paused while this has focus</span></div>
          </div>
          <div class="redact-foot">
            <span class="badge iris"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="12" height="6" rx="1"/></svg>2 items masked, none left to review</span>
            <span class="small-cap">Sample text. The masks are painted into the stored image.</span>
          </div>
        </div>
        <div class="progress"><i class="on"></i><i class="on"></i><i></i><i></i></div>
      </div>
    </article>

    <article class="feature" data-pill="drafting" aria-labelledby="h-f3">
      <div class="copy">
        <h3 id="h-f3">A draft to read, not a blank box to fill.</h3>
        <p>When the session stops, the note is waiting: Problem, Steps, Result and Follow-ups, each step beside the screenshot it happened on. The ticket is picked from the remote window's title and the time entry is filled in. A step drawn only from the screen, with nothing said about it, is marked for a second look.</p>
        <dl class="points">
          <div><dt>Edit</dt><dd>Click any line to change it; reorder steps from the keyboard</dd></div>
          <div><dt>Choose</dt><dd>Internal note, or a discussion the customer sees</dd></div>
          <div><dt>Adapt</dt><dd>Picks up a few habits from your edits, such as past tense or shorter steps</dd></div>
        </dl>
      </div>
      <div class="mock" data-replay aria-hidden="true">
        <div class="mock-bar"><span>review · draft</span><span>3 steps · 3 screenshots</span></div>
        <div class="mock-body note">
          <div class="note-head">
            <span class="chip"><b>#48213</b> Printer offline · Acme Dental</span>
            <span class="chip on">Internal note</span>
            <span class="chip">Time <b>15</b> min</span>
          </div>
          <h3 class="i0">Problem</h3>
          <div class="ln i1"><span></span><span>Nothing would print from the reception workstation; jobs sat in the queue.</span><span></span></div>
          <h3 class="i2">Steps</h3>
          <div class="ln i3"><span>1.</span><span>Found the Print Spooler service stopped.</span><span class="shot"></span></div>
          <div class="ln flag i4"><span>2.</span><span>Started the service and set it to restart automatically on failure. <span class="badge warn sm">Inferred from screen only</span></span><span class="shot"></span></div>
          <div class="ln i5"><span>3.</span><span>Cleared the stuck queue and printed a test page.</span><span class="shot"></span></div>
          <h3 class="i6">Result</h3>
          <div class="ln i7"><span></span><span>Printing works again from the reception PC.</span><span></span></div>
          <div class="note-foot"><span class="publish">Publish <kbd>Ctrl+Enter</kbd></span></div>
        </div>
        <div class="progress"><i class="on"></i><i class="on"></i><i class="on"></i><i></i></div>
      </div>
    </article>

    <article class="feature" data-pill="published" aria-labelledby="h-f4">
      <div class="copy">
        <h3 id="h-f4">One press, and it lands where it belongs.</h3>
        <p>Publish sends the note and the time entry to the ConnectWise ticket, and the article to Hudu as a draft under the right company. The receipt says what landed, with a link to each.</p>
        <dl class="points">
          <div><dt>Person</dt><dd>Nothing is published until a technician presses Publish</dd></div>
          <div><dt>Unsure</dt><dd>A send whose answer was lost is held as "Not confirmed" until you check the ticket, so it isn't sent again by accident</dd></div>
          <div><dt>Offline</dt><dd>A session recorded offline is drafted once the connection is back</dd></div>
        </dl>
      </div>
      <div class="mock" data-replay aria-hidden="true">
        <div class="mock-bar"><span>review · published</span><span>14:24</span></div>
        <div class="mock-body">
          <div class="receipt-head"><div><b>Published to ticket #48213</b><small>Acme Dental · Printer offline · 14:24</small></div><img src={glyphDark.src} alt="" width="26" height="26" /></div>
          <div class="rrow i0"><svg class="ck" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3 3 7-7"/></svg><span><b>Ticket note</b> · Internal note</span><span class="badge ok">Sent</span><span class="dst">ConnectWise</span></div>
          <div class="rrow i1"><svg class="ck" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3 3 7-7"/></svg><span><b>Time entry</b> · 0:15</span><span class="badge ok">Sent</span><span class="dst">ConnectWise</span></div>
          <div class="rrow i2"><svg class="ck" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5l3 3 7-7"/></svg><span><b>KB article</b> · Printer offline: print spooler stopped</span><span class="badge ok">Sent</span><span class="dst">Hudu</span></div>
          <div class="outbox"><span class="badge iris">Next to check</span>ScreenConnect session · 1 min · <kbd>Enter</kbd> opens it</div>
        </div>
        <div class="progress"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i></div>
      </div>
    </article>
  </section>

  <section class="realapp wrap" aria-labelledby="h-real">
    <h2 id="h-real">The real app, not a mock-up.</h2>
    <p class="sub">The screens a technician works in, shown here with sample tickets and companies.</p>
    <figure class="frame-fig">
      <span class="tag">review · sample data</span>
      <Image src={review} widths={[640, 960, 1264]} sizes="(max-width: 1264px) 100vw, 1136px" loading="lazy" alt="The ScreenTrail Review screen: the drafted note for ticket 48213, Printer offline: print spooler stopped, with Problem and Steps beside their screenshots, the ticket matched from the ScreenConnect window title, a 15-minute time entry and a Publish button." />
    </figure>
    <div class="realapp-row">
      <figure><div class="frame-fig"><Image src={published} widths={[400, 640]} sizes="(max-width: 960px) 100vw, 360px" loading="lazy" alt="The receipt after publishing to ticket 48213, with the ticket note, time entry and KB article sent." /></div><figcaption>The receipt, with the next session to check.</figcaption></figure>
      <figure><div class="frame-fig"><Image src={history} widths={[400, 640]} sizes="(max-width: 960px) 100vw, 360px" loading="lazy" alt="All sessions: six sessions with their start time, duration, status (Partial capture, Draft, Published, Discarded, Not confirmed), remote tool and screenshot count." /></div><figcaption>All sessions, by status and remote tool.</figcaption></figure>
      <figure><div class="frame-fig"><Image src={tray} widths={[353]} loading="lazy" alt="The tray menu while recording: Pause, Stop and draft, Discard session, Open ScreenTrail, Session history, What's being captured right now, Settings, Set up ScreenTrail and Quit." /></div><figcaption>The tray menu during a session.</figcaption></figure>
    </div>
  </section>

  <section class="stack wrap" id="stack" aria-labelledby="h-stack">
    <h2 id="h-stack">Fits the stack you already run.</h2>
    <p class="sub mt">It starts on its own in the remote tool your technicians open, and publishes into the PSA and documentation you already use.</p>
    <ul class="grid">
      <li class="cell">ScreenConnect<small>remote tool</small></li>
      <li class="cell">Splashtop<small>remote tool</small></li>
      <li class="cell">Remote Desktop<small>remote tool</small></li>
      <li class="cell">TeamViewer<small>remote tool</small></li>
      <li class="cell">AnyDesk<small>remote tool</small></li>
      <li class="cell center">Built for MSPs on ConnectWise and Hudu</li>
      <li class="cell">ConnectWise PSA<small>note · time entry</small></li>
      <li class="cell">Hudu<small>KB article</small></li>
      <li class="cell later">HaloPSA<small>planned</small></li>
      <li class="cell later">Your next tool<small>tell us in the pilot</small></li>
      <li class="cell">Windows<small>desktop app</small></li>
      <li class="cell">Gemini or Claude<small>drafting model</small></li>
    </ul>
    <p class="stack-note">The ConnectWise and Hudu connections are built to their published APIs; their first checks against live accounts are part of the pilot. Product names belong to their owners, and no endorsement is implied.</p>
  </section>

  <section class="setup wrap" aria-labelledby="h-setup">
    <div class="setup-copy">
      <h2 id="h-setup">Three steps per technician.</h2>
      <p class="sub">One installer per technician PC. Your ScreenTrail owner connects ConnectWise and Hudu once in the web admin, and a seven-step setup walks each technician through the rest.</p>
    </div>
    <ol class="steps">
      <li class="stepbox"><span class="num" aria-hidden="true">1</span><div><h3>Install on each technician's PC</h3><p>One installer for the app and its capture service.</p></div></li>
      <li class="stepbox"><span class="num" aria-hidden="true">2</span><div><h3>Activate with an invite code</h3><p>Your ScreenTrail owner invites each technician; the code works once, on one PC.</p>
        <div class="code"><span class="fn">Setup · Activate</span>Invite code <em>XXXXX-XXXXX-XXXXX-XXXXX</em></div></div></li>
      <li class="stepbox"><span class="num" aria-hidden="true">3</span><div><h3>Pick the remote tools</h3><p>Choose which tools start a session. The ConnectWise and Hudu connection is already there.</p>
        <div class="code"><span class="fn">Setup · Remote tools</span>[x] ScreenConnect&nbsp;&nbsp;[x] Remote Desktop&nbsp;&nbsp;[ ] AnyDesk</div></div></li>
    </ol>
  </section>

  <MaskBand label="masked on the PC" />

  <section class="privacy wrap" id="privacy" aria-labelledby="h-privacy">
    <h2 id="h-privacy">Built for the security review your clients will ask for.</h2>
    <div class="privacy-grid">
      <div>
        <ul class="trust">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/></svg><h3>No always-on capture</h3><p>Only while a remote tool is in front, with the pill on screen the whole time.</p></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="9" width="16" height="6" rx="1"/><path d="M4 5h16M4 19h10"/></svg><h3>Secrets masked on the PC</h3><p>Passwords, card numbers and keys it reads are painted out before storage.</p></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0014 0M12 18v3"/></svg><h3>Voice stays local</h3><p>Transcribed on the PC. The end user's voice is not recorded.</p></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3l7 3v6c0 4-3 7.5-7 9-4-1.5-7-5-7-9V6z"/></svg><h3>A local-only switch</h3><p>Nothing is sent for drafting; your ScreenTrail owner can lock it on.</p></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg><h3>Encrypted at rest</h3><p>Sessions in an encrypted store; PSA credentials in an encrypted vault.</p></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg><h3>Kept as long as you say</h3><p>Retention set by the MSP; discarding a session deletes its captures.</p></li>
        </ul>
        <div class="privacy-more">
          <a class="btn btn-line" href="/security/">How ScreenTrail handles data</a>
          <a class="btn btn-line" href={`${site.repo}/tree/main/docs/security`}>Read the privacy pack</a>
        </div>
      </div>
      <figure class="plain-fig">
        <div class="frame-fig"><Image src={panel} widths={[404]} loading="lazy" alt="What's being captured right now: capturing ScreenConnect, local-only on, nothing suppressed, the redaction queue, frames dropped, egress blocked, the policy in force, and a Copy diagnostics button." /></div>
        <figcaption>Any technician can open "What's being captured right now?" from the tray.</figcaption>
      </figure>
    </div>
  </section>

  <section class="pilot wrap" id="pilot" data-pill="published" aria-labelledby="h-pilot">
    <h2 id="h-pilot">The note this page wrote.</h2>
    <p class="sub mt">You have just followed a session. Here is its draft. The follow-up is yours.</p>
    <article class="final-note" aria-labelledby="h-become">
      <div class="fn-main note">
        <div class="fn-head"><h3 id="h-become">Become a pilot MSP</h3><span class="chip">To: you · internal note</span></div>
        <div class="fn-sec"><h4>Problem</h4><p>Technicians write notes from memory after the session. Steps go missing, time goes unbilled, and the fix is never written up for the next person.</p></div>
        <div class="fn-sec"><h4>Steps</h4>
          <ol>
            <li>Followed the session: the screen, the clicks and the technician's voice.</li>
            <li>Masked passwords, keys and card numbers on the PC.</li>
            <li>Drafted the note, the time entry and a KB article.</li>
            <li>Waited for a person to check it and publish.</li>
          </ol>
        </div>
        <div class="fn-sec"><h4>Result</h4>
          <dl class="targets">
            <div><dt>60%</dt><dd>less time writing notes, at least</dd></div>
            <div><dt>&lt;25%</dt><dd>of a draft's words changed before publishing, at most</dd></div>
            <div><dt>80%</dt><dd>of remote sessions captured without starting one by hand</dd></div>
            <div><dt>0</dt><dd>passwords or personal data in a published note</dd></div>
          </dl>
          <span class="flagnote">Not measured yet: these are the pilot's targets, not results.</span>
        </div>
        <div class="fn-sec"><h4>Follow-ups</h4>
          <p>A small number of MSPs, real tickets, and a plain account of where it falls short.</p>
          <dl class="fit">
            <div><dt>Team</dt><dd>3 to 30 technicians working tickets over remote sessions</dd></div>
            <div><dt>Stack</dt><dd>ConnectWise PSA, with Hudu if you use it; ScreenConnect or Remote Desktop</dd></div>
            <div><dt>Before</dt><dd>A short measure of how long notes take today</dd></div>
            <div><dt>During</dt><dd>A few weeks of real use, with a direct line to the people building it</dd></div>
          </dl>
        </div>
      </div>
      <aside class="fn-side" aria-labelledby="h-form">
        <div aria-hidden="true"><span class="lbl">Captured on this page</span><span class="clockv" id="note-clock">10:00</span></div>
        <div><span class="lbl" id="h-form">Tell us about your team</span></div>
        <form class="pilot-form" method="post" action="/api/pilot" id="pilot-form">
          <label>Your name<input name="name" autocomplete="name" required maxlength={limits.name} /></label>
          <label>Work email<input name="email" type="email" autocomplete="email" required maxlength={limits.email} /></label>
          <label>Company<input name="company" autocomplete="organization" required maxlength={limits.company} /></label>
          <label>Technicians
            <select name="technicians" required>
              <option value="" selected disabled>Choose one</option>
              {choices.technicians.map((c) => <option>{c}</option>)}
            </select>
          </label>
          <label>PSA
            <select name="psa" required>
              <option value="" selected disabled>Choose one</option>
              {choices.psa.map((c) => <option>{c}</option>)}
            </select>
          </label>
          <label>Main remote tool
            <select name="tool" required>
              <option value="" selected disabled>Choose one</option>
              {choices.tool.map((c) => <option>{c}</option>)}
            </select>
          </label>
          <label><span>Anything else <span class="opt">(optional)</span></span><textarea name="message" maxlength={limits.message} rows="3"></textarea></label>
          <div class="hp" hidden><label>Leave this empty<input name="hp_trap" tabindex="-1" autocomplete="off" /></label></div>
          <button class="publish-btn" type="submit">Send to ScreenTrail <kbd aria-hidden="true">Ctrl+Enter</kbd></button>
          <p class="form-fine">We use this only to reply about the pilot, and the site keeps no copy. <a href="/privacy/">Privacy</a></p>
        </form>
      </aside>
    </article>
  </section>
</Base>

<script src="../scripts/home.ts"></script>
