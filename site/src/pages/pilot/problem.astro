---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
---
<Base title="Not sent" noindex notice={false}>
  <div class="page wrap">
    <header class="page-head">
      <span class="tag">Not sent</span>
      <h1>Your note was not sent.</h1>
      <p class="sub">A field may have been missing, or too many were sent from your network in the last minute. Go back and try again, or email us directly.</p>
    </header>
    <p class="prose"><span>Email <a href={`mailto:${site.contactEmail}?subject=ScreenTrail%20pilot`}>{site.contactEmail}</a> with your team size, PSA and remote tool.</span></p>
    <p><a class="btn btn-dark" href="/#pilot">Back to the form</a></p>
  </div>
</Base>
