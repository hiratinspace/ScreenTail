---
import Base from '../../layouts/Base.astro';
---
<Base title="Thanks" noindex notice={false}>
  <div class="page wrap">
    <header class="page-head">
      <span class="tag">Published</span>
      <h1>Thanks. Your note reached the ScreenTrail team.</h1>
      <p class="sub">We read every one and will reply to the email you gave, usually within two working days.</p>
    </header>
    <p class="prose">While you wait, the security page says what ScreenTrail captures, what it masks and what it does not protect yet.</p>
    <p class="page-actions"><a class="btn btn-dark" href="/security/">How ScreenTrail handles data</a><a class="btn btn-line" href="/">Back to the home page</a></p>
  </div>
</Base>
