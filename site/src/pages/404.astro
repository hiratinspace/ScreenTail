---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="page wrap">
    <header class="page-head">
      <span class="tag">404</span>
      <h1>There is no page here.</h1>
      <p class="sub">The address may be mistyped, or the page has moved.</p>
    </header>
    <p class="page-actions"><a class="btn btn-dark" href="/">Go to the home page</a><a class="btn btn-line" href="/security/">Security and privacy</a></p>
  </div>
</Base>
