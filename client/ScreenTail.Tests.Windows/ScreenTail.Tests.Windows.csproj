<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-bound tests (ADR-0002): adapters that need real Windows APIs. They run in CI's Windows jobs and
       are skipped elsewhere via [Fact(SkipUnless = ...)]. Compiles on any OS thanks to EnableWindowsTargeting. -->
  <PropertyGroup>
    <!-- Windows SDK projections, for Windows.Media.Ocr (ST-041): built into Windows, hardware
         accelerated, no native binaries or language data to ship, and it works on ARM where Tesseract
         does not. Fewer third-party binaries is also a smaller attack surface. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The Review pane's view models live in the UI project and need WPF's imaging to decode a
         thumbnail; the one test that measures what the filmstrip holds in memory needs both. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>ScreenTail.Tests.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF drops System.IO from the implicit usings (Path would be ambiguous with WPF's Shapes.Path
         in XAML-heavy code); these tests are not that, and they read files. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
    <ProjectReference Include="..\ScreenTail.Core\ScreenTail.Core.csproj" />
    <ProjectReference Include="..\ScreenTail.Service\ScreenTail.Service.csproj" />
    <ProjectReference Include="..\ScreenTail.UI\ScreenTail.UI.csproj" />
  </ItemGroup>
</Project>
