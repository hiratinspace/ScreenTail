<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral capture logic (ADR-0002). Must never reference Windows-only APIs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScreenTail.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite + SQLCipher; the bundle carries native libraries for Windows, macOS and Linux. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
  </ItemGroup>

  <ItemGroup>
    <!-- Numbered migrations (Guide §5), applied in order by SqliteSessionStore. -->
    <EmbeddedResource Include="Store\Migrations\*.sql" LogicalName="ScreenTail.Core.Store.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenTail.Shared\ScreenTail.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The redaction tests stand in for the pattern library to simulate a detector running out of budget. -->
    <InternalsVisibleTo Include="ScreenTail.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ST-023: one registry, shipped with the service and used by its tests. -->
    <None Include="..\..\shared\registry\remote-tools.json" Link="Registry\remote-tools.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
