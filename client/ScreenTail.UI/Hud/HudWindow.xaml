<Window x:Class="ScreenTail.UI.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hud="clr-namespace:ScreenTail.UI.Hud"
        xmlns:controls="clr-namespace:ScreenTail.UI.Controls"
        Title="ScreenTail"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False">
    <!-- The app's styles are looked up dynamically, not statically. A static lookup throws while the
         window is built when the app's resources are not there, which is the case on the bare UI thread
         the shell's quit and re-dock tests run on; a dynamic one resolves to the same style in the app. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <!-- v0.5: the segments after the state are set off by a short rule, so the pill reads as
         "state | mic | redactions" at a glance instead of one run of small grey words. -->

    <!-- 44 px tall, 999 radius, bg.surface on border.strong (Spec §5 S2). -->
    <Border x:Name="Pill"
            Height="44"
            CornerRadius="22"
            Padding="16,0,18,0"
            Background="{DynamicResource Brush.bg.surface}"
            BorderBrush="{DynamicResource Brush.border.strong}"
            BorderThickness="1"
            MouseLeftButtonDown="OnPillMouseDown"
            MouseRightButtonUp="OnPillRightClick">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- The state segment. Glyph and words both, so it reads with no colour at all (Spec §7) —
                 which matters more here than anywhere: this is the indicator INV-4 is about. -->
            <!-- DataTriggers with DynamicResource, not a converter. A converter resolves the brush once,
                 at bind time, so it cannot follow a theme swap — and the first version silently produced
                 no Foreground at all for three of the four tones, leaving the glyph the TextBlock default
                 black. The render now asserts each variant's token colour is actually on the pill, which
                 is what caught it. -->
            <TextBlock x:Name="StateGlyphText"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource Size.lg}"
                       Text="{Binding StateGlyph}"
                       ToolTip="{Binding StateTooltip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="Recording">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.state.recording}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Paused">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Scope">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.state.scope}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- The state in words while recording. The other states say theirs in StateText; recording's
                 is the elapsed time, and a red dot beside a number is colour plus a clock, not a word. -->
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource Font.ui}"
                       FontSize="{DynamicResource Size.md}"
                       FontWeight="{DynamicResource Weight.semibold}"
                       Foreground="{DynamicResource Brush.text.primary}"
                       Text="Recording">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="Recording">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Style="{DynamicResource Text.Body}"
                       FontWeight="{DynamicResource Weight.semibold}"
                       Typography.NumeralAlignment="Tabular"
                       Text="{Binding StateText}"
                       ToolTip="{Binding StateTooltip}"
                       AutomationProperties.Name="{Binding SpokenState}"
                       controls:LiveRegion.Setting="Assertive"
                       controls:LiveRegion.Key="{Binding Announcement}" />

            <Border Margin="12,0,0,0"
                    Padding="12,0,0,0"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.border.subtle}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowMic, Converter={StaticResource Visible}}">
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource Text.Muted}"
                           Text="{Binding MicTooltip}"
                           ToolTip="{Binding MicTooltip}" />
            </Border>

            <Border Margin="12,0,0,0"
                    Padding="12,0,0,0"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.border.subtle}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowRedactions, Converter={StaticResource Visible}}">
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource Text.Muted}"
                           Text="{Binding RedactionText}"
                           ToolTip="Screenshots still being masked. They are not readable until this reaches zero." />
            </Border>

            <Border Margin="12,0,0,0"
                    Padding="12,0,0,0"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.border.subtle}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowCloud, Converter={StaticResource Visible}}">
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource Text.Muted}"
                           Text="☁ Offline"
                           ToolTip="{Binding CloudTooltip}" />
            </Border>

            <!-- Expanded: the last three events and Mark moment (Spec §5 S2). Counts and kinds only —
                 a HUD a customer can see over a technician's shoulder holds no content (INV-10). -->
            <StackPanel Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding Expanded, Converter={StaticResource Visible}}">
                <controls:Repeater ItemsSource="{Binding RecentEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{DynamicResource Text.Muted}" FontSize="{DynamicResource Size.xs}" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
            </StackPanel>

            <Button Margin="16,0,0,0"
                    Style="{DynamicResource Pill.Control}"
                    Content="Mark moment"
                    Command="{Binding MarkCommand}"
                    Visibility="{Binding Expanded, Converter={StaticResource Visible}}" />
        </StackPanel>
    </Border>
</Window>
