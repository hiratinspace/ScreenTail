<!-- Spec §3 component library. Every colour, size and radius comes from the token dictionaries via
     DynamicResource, so themes swap without touching a component. Keys: "<Component>.<Variant>".

     v0.5 (ST-016, the modern pass): every control has rest, hover, pressed, keyboard-focus and disabled
     looks built from the tokens, and the stock WPF controls the views use without a key (check box, radio,
     combo, list, scroll bar, slider, password box, tool tip) get a keyless style here so no default grey
     Windows 7 chrome is left on a dark window. A disabled control keeps its words in text.muted on
     bg.raised, which is held to 4.5:1, rather than fading the whole thing to 45% opacity. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:ScreenTail.UI.Controls">

    <!-- Focus ring: 2 px accent just outside the control; WPF shows FocusVisualStyle for keyboard focus only. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="8"
                               RadiusY="8"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.accent.primary}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <!-- A line with nothing to say takes no room and is not there for a screen reader: an empty text
             is a zero-sized element that Accessibility Insights fails (ST-084). Every text style is based on
             this one. A visibility bound on the element itself still wins. -->
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Text.Secondary" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
    </Style>
    <Style x:Key="Text.Muted" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
    </Style>
    <!-- A field's name above its control: smaller than the value, and quieter, but not a hint. -->
    <Style x:Key="Text.Label" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
    </Style>
    <Style x:Key="Text.Mono" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
    </Style>
    <Style x:Key="Text.SectionHeading" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.lg}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
    </Style>
    <Style x:Key="Text.ScreenTitle" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.display}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.xl}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
    </Style>
    <Style x:Key="Text.Error" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
    </Style>
    <!-- A Windows icon-font glyph (Segoe Fluent Icons, or MDL2 before Windows 11). Decoration beside
         words that already say the same thing, never the only signal. -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.icon}" />
        <Setter Property="FontSize" Value="{DynamicResource Icon.control}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- An empty or waiting pane: a large icon in a soft circle, one line of what is going on. -->
    <Style x:Key="EmptyState.Icon" BasedOn="{StaticResource Icon}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Button: primary, secondary, subtle (ghost), danger. 32 px tall at least; the reason a button is
         disabled goes beside it as text (v0.4.3), and in its ToolTip for the mouse. -->
    <ControlTemplate x:Key="Button.Template" TargetType="ButtonBase">
        <Border x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Radius.control}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.regular}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Primary" BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.on-accent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.accent.primary.hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.on-accent}" />
                <Setter Property="Opacity" Value="0.85" />
            </Trigger>
            <!-- Neutral when disabled, the way Windows 11 does it: a faded accent reads as "primary, but
                 broken", and its words fell to about 2:1. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Ghost" BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Subtle is the Windows 11 name for the same button. -->
    <Style x:Key="Button.Subtle" BasedOn="{StaticResource Button.Ghost}" TargetType="Button" />
    <Style x:Key="Button.Danger" BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.danger}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost, danger on hover (Spec §5 S3, Review's Discard): quiet at rest beside Publish, and plainly the
         destructive one the moment the pointer or the keyboard reaches it. Keyboard focus takes the same
         look as hover, so a technician tabbing to it sees what it is before pressing it. -->
    <Style x:Key="Button.GhostDanger" BasedOn="{StaticResource Button.Ghost}" TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.danger}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.danger}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Chip: a small rounded button inside content, like a step's "frame 2". 28 px is the hit-target floor. -->
    <Style x:Key="Chip" BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Navigation tab in the shell's header. Tag="Selected" marks the current view: the words go to
         text.primary and an accent bar sits under them, so the place is shown by shape as well as colour. -->
    <Style x:Key="Nav.Item" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Rectangle x:Name="Indicator"
                                   Width="20"
                                   Height="3"
                                   Margin="0,0,0,1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Fill="{DynamicResource Brush.accent.primary}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                            <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Input / Search: default and error; the validation message is a Text.Error line below, never a dialog.
         Focus is the accent outline thickening to 2 px, and from the keyboard the focus ring outside it too
         (Spec §3): on a scaled screen in high contrast the thickened outline alone was too faint to see,
         since the system's frame and highlight colours are close in luminance (ST-084, the laptop's run). -->
    <Style x:Key="Input.Default" TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Multiline: the note's own fields, which are prose and grow. Input.Default fixes a height and
         centres its content, which turns a three-line step into one clipped line. -->
    <Style x:Key="Input.Multiline" BasedOn="{StaticResource Input.Default}" TargetType="TextBox">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- In place (Spec v0.6.0 §5 S3, "The note is edited in place as it will land"): the note's own text,
         read as the ticket will show it. At rest it is the text on the pane inside a faint 1 px edge
         (v0.6.8, owner decision: a field that looked like plain text until it was focused did not say it
         could be typed in). The edge is border.strong, the quiet one the secondary buttons carry: 1.75:1
         on the light pane and 1.53:1 on the dark, seen but well under the 3:1 control edge, so the note
         still reads as a note. Hover shows the control edge (border.control), and focus is the accent
         outline at 2 px and the focus ring, as on every other field. High contrast maps all three to
         system colours. -->
    <Style x:Key="Input.InPlace" BasedOn="{StaticResource Input.Multiline}" TargetType="TextBox">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.control}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A step's frame on its row (Spec v0.6.0 §5 S3): the thumbnail is the button. Its edge is the control
         edge, so the picture reads as something to press, and hover and press tint it like a chip. -->
    <Style x:Key="StepFrame" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Input.Error" BasedOn="{StaticResource Input.Default}" TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.danger}" />
    </Style>
    <!-- The typed confirmations: a phrase to copy exactly, so it is set in the monospace face. -->
    <Style x:Key="Input.Mono" BasedOn="{StaticResource Input.Default}" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.mono}" />
    </Style>

    <!-- Password box: the same chrome as a text box (Integrations' private key and API key). -->
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box: an 18 px rounded box with a drawn tick, filled with the accent when on. -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.text.muted}" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="Tick"
                                      Width="10"
                                      Height="8"
                                      Data="M0.5,4 L3.5,7 L9.5,0.5"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource Brush.text.on-accent}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                                <Rectangle x:Name="Dash"
                                           Width="8"
                                           Height="2"
                                           Fill="{DynamicResource Brush.text.on-accent}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.text.secondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary.hover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary.hover}" />
                        </MultiTrigger>
                        <!-- Disabled: the box goes neutral and the tick stays, so a locked setting still says
                             which way it is set. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.bg.raised}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
                            <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource Brush.text.muted}" />
                            <Setter TargetName="Dash" Property="Fill" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio: an 18 px circle; on is an accent ring around a dot in the on-accent colour. -->
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.text.muted}" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot"
                                     Width="8"
                                     Height="8"
                                     Fill="{DynamicResource Brush.text.on-accent}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.bg.hover}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.text.secondary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.bg.raised}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.border.strong}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segment: one choice of a segmented control (Spec v0.6.0 §5 S3, the envelope's As line). Radio
         buttons in a Segment.Group, so the choice is visible and one key press away. The chosen one is the
         selection tint with its words in semibold and a 2 px accent bar under them, so it is told by shape
         and weight as well as colour; in high contrast the tint is the window colour and the bar and the
         weight remain. -->
    <Style x:Key="Segment.Group" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.control}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.regular}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="Bar"
                                    Height="{DynamicResource Focus.width}"
                                    Margin="{DynamicResource Padding.control}"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush.accent.primary}"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check chip: a destination in the envelope's Also line, a check box drawn as a bordered chip with
         its box inside, so each destination reads as a value that is on or off. -->
    <Style x:Key="CheckChip" BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
        <Setter Property="Padding" Value="{DynamicResource Padding.control}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource Brush.bg.raised}"
                            BorderBrush="{DynamicResource Brush.border.control}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="{DynamicResource Icon.control}"
                                    Height="{DynamicResource Icon.control}"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.control}">
                                <Path x:Name="Tick"
                                      Width="9"
                                      Height="7"
                                      Data="M0.5,4 L3.5,7 L9.5,0.5"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource Brush.text.on-accent}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.bg.raised}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
                            <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A shortcut beside the control it belongs to ("Ctrl+T"): small, quiet, outlined like a key cap. -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.control}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.text.muted}" />
    </Style>
    <!-- The shortcut's words, in a key cap or inside the button it presses ("Publish  Ctrl+Enter"): the
         foreground is inherited, so on the filled button it is the on-accent colour. -->
    <Style x:Key="Text.KeyHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.xs}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.regular}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Toggle: default and locked (admin). Off is an outlined track, on is the accent, as Windows 11 draws it. -->
    <Style TargetType="controls:ToggleSwitch">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToggleSwitch">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="Track"
                                Width="40"
                                Height="20"
                                Background="{DynamicResource Brush.bg.raised}"
                                BorderBrush="{DynamicResource Brush.text.secondary}"
                                BorderThickness="1"
                                CornerRadius="10" />
                        <Ellipse x:Name="Thumb"
                                 Width="12"
                                 Height="12"
                                 Margin="4,0,0,0"
                                 HorizontalAlignment="Left"
                                 Fill="{DynamicResource Brush.text.secondary}" />
                        <Path x:Name="Lock"
                              Width="8"
                              Height="10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M2,4 V3 A2,2 0 0 1 6,3 V4 H7 V9 H1 V4 Z"
                              Fill="{DynamicResource Brush.text.on-accent}"
                              Stretch="Uniform"
                              Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                            <Setter TargetName="Thumb" Property="Width" Value="14" />
                            <Setter TargetName="Thumb" Property="Height" Value="14" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.text.on-accent}" />
                        </Trigger>
                        <Trigger Property="IsLocked" Value="True">
                            <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Combo box (read-only, the only kind the views use): the input's chrome, a chevron, and a raised
         surface for the list. -->
    <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <Path Width="10"
                              Height="6"
                              Margin="0,0,12,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Data="M0.5,0.5 L5,5 L9.5,0.5"
                              Stretch="Fill"
                              Stroke="{DynamicResource Brush.text.secondary}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Rectangle x:Name="Indicator"
                                   Width="3"
                                   Height="16"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Fill="{DynamicResource Brush.accent.primary}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Style="{StaticResource ComboBox.Toggle}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="11,4,34,4"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Padding="4"
                                    Background="{DynamicResource Brush.bg.surface}"
                                    BorderBrush="{DynamicResource Brush.border.strong}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.card}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List box and its rows, wherever a view uses one without a style of its own (ticket matches, the
         transcript). Selection is a tint plus an accent bar at the left edge, so it survives high contrast,
         where the tint is the window colour. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Rectangle x:Name="Indicator"
                                   Width="3"
                                   Height="16"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Fill="{DynamicResource Brush.accent.primary}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars: a slim rounded thumb on a clear track. The default is a light grey bar that sat
         on every dark pane like a stripe of white paint. -->
    <!-- A track's page areas are PageButtons: repeat buttons UI Automation does not list as controls, since
         a screen reader scrolls through the pane's Scroll pattern (ST-084). -->
    <Style x:Key="ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Margin="3" Background="{TemplateBinding Background}" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.text.muted}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.text.secondary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <controls:PageButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.Page}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <controls:PageButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.Page}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <controls:PageButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.Page}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <controls:PageButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.Page}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template" Value="{StaticResource ScrollBar.Vertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource ScrollBar.Horizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Slider: a 4 px rounded track, the accent up to an 18 px thumb. Horizontal, as every slider here is. -->
    <Style x:Key="Slider.Fill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" Margin="9,0,-9,0" VerticalAlignment="Center" Background="{DynamicResource Brush.accent.primary}" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18" Background="Transparent">
                        <Ellipse Fill="{DynamicResource Brush.bg.surface}" Stroke="{DynamicResource Brush.border.strong}" StrokeThickness="1" />
                        <Ellipse x:Name="Core" Width="10" Height="10" Fill="{DynamicResource Brush.accent.primary}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Core" Property="Width" Value="12" />
                            <Setter TargetName="Core" Property="Height" Value="12" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Core" Property="Fill" Value="{DynamicResource Brush.text.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" Margin="9,0" VerticalAlignment="Center" Background="{DynamicResource Brush.border.strong}" CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <controls:PageButton Command="Slider.DecreaseLarge" Style="{StaticResource Slider.Fill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <controls:PageButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollBar.Page}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tool tip: a small raised surface that wraps, in the app's type rather than the system's. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="10,6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.control}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Badge: pill, 11 px, uppercase off, a tinted fill with a border in the state's colour and the words
         in text.primary. Variants: neutral, Suggested, Confidence, Published, Unconfirmed. -->
    <Style x:Key="Badge" TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.xs}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Badge.Suggested" BasedOn="{StaticResource Badge}" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
    </Style>
    <Style x:Key="Badge.Confidence" BasedOn="{StaticResource Badge}" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.warning}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.confidence.low}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
    </Style>
    <Style x:Key="Badge.Published" BasedOn="{StaticResource Badge}" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.success}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.published}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
    </Style>
    <!-- A publish that may have reached the ticket and was never confirmed: the warning tint and the
         paused border the warning banner uses, so it reads as "look at this", not as done (Published's
         green) and not as failed (danger). The words carry it; the colour only agrees with them. -->
    <Style x:Key="Badge.Unconfirmed" BasedOn="{StaticResource Badge}" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.warning}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.paused}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
    </Style>
    <!-- The shell's capture state: the badge at body-adjacent size, because it is read, not glanced at. -->
    <Style x:Key="Badge.Status" BasedOn="{StaticResource Badge}" TargetType="ContentControl">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.regular}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <!-- State dot: colour as indicator (Spec §2.1 v0.4.2), always next to a text label -->
    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.state.recording}" />
    </Style>

    <!-- Meter.Level: the microphone's live level in Settings, Capture (ST-080 AC3, Spec §5 S5). A thin
         track with the accent fill, as the wireframe draws it; not focusable, since there is nothing to
         do with it. Its words are beside it, never only the bar. -->
    <Style x:Key="Meter.Level" TargetType="ProgressBar">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Width" Value="160" />
        <Setter Property="Height" Value="8" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border BorderBrush="{DynamicResource Brush.border.strong}" BorderThickness="1" Background="{DynamicResource Brush.bg.base}" CornerRadius="2">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource Brush.accent.primary}" CornerRadius="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Banner: inline at the top of a pane; info, warning and error. A tinted fill and a border in the
         kind's colour, and the kind always in words and a glyph too (Spec §7). -->
    <Style x:Key="Banner.Info" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="Banner.Warning" BasedOn="{StaticResource Banner.Info}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.warning}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.paused}" />
    </Style>
    <Style x:Key="Banner.Error" BasedOn="{StaticResource Banner.Info}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.danger}" />
    </Style>

    <!-- Toast: floats, so it is the one thing besides the pill with a shadow. -->
    <Style x:Key="Toast" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MaxWidth" Value="440" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24"
                                  Direction="270"
                                  Opacity="0.28"
                                  ShadowDepth="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card: a layer above the window, outlined rather than shadowed. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.card}" />
    </Style>
    <!-- Pane: one of Review's three columns, a card with no outer margin of its own. -->
    <Style x:Key="Pane" BasedOn="{StaticResource Card}" TargetType="Border">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Settings (Spec v0.6.0, Settings layout): the section nav, the "Changed" mark, the bar's link and
         the one Save bar. Tokens only; in high contrast each takes the system colours through them, and
         every state keeps its words and its mark. -->
    <Style x:Key="Settings.Nav" BasedOn="{StaticResource {x:Type ListBox}}" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    </Style>
    <!-- A nav row: 36 px, the selected one tinted with the accent bar at its left edge (the keyless row's),
         and its name read with the count of its changes. -->
    <Style x:Key="Settings.NavItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.row-height}" />
        <Setter Property="Padding" Value="14,6,10,6" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    </Style>

    <!-- A change not yet saved: the iris dot and the words in text.primary on the iris tint, an accent
         edge. Beside a card's heading it says "Changed"; in the nav it is the count. -->
    <Style x:Key="Badge.Changed" BasedOn="{StaticResource Badge}" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,5,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.accent.primary}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A link that acts inside the screen (the Save bar's section name): accent words, underlined, with
         the hit-target floor and the focus ring. -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.control}" SnapsToDevicePixels="True">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextDecorations="Underline" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.accent.primary.hover}" />
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The Save bar: a raised strip pinned under the page, outlined above, so it reads as the page's own
         and not as a toast. No shadow: the frame and the pill are the only things that float. -->
    <Style x:Key="SaveBar" TargetType="Border">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
    </Style>

    <!-- Status pill (HUD): 44 px, fully rounded, elevated -->
    <Style x:Key="StatusPill" BasedOn="{StaticResource Toast}" TargetType="Border">
        <Setter Property="Height" Value="{DynamicResource Layout.hud-height}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.pill}" />
        <Setter Property="Padding" Value="16,0,6,0" />
        <Setter Property="MaxWidth" Value="720" />
    </Style>
    <Style x:Key="Pill.Control" BasedOn="{StaticResource Button.Secondary}" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same pill for a ToggleButton. A style cannot be based on one for another target type, and
         the filmstrip's blur toggle was based on Pill.Control: it parsed only when the pane was never
         rendered, and threw the first time the shell hosted it (2026-09-25). Same setters, same
         template; the checked look is the caller's, because what "on" means is theirs. -->
    <Style x:Key="Pill.Toggle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- v0.6.0 (Outbox): the pill is part of the frame (Spec §5 S2). Its controls sit on shell.bg, so they
         take the frame's tokens: shell.text for the icon and words, shell.hover under the pointer, and a
         focus ring in shell.accent, which is 4.5:1 or more on shell.bg and shell.hover in both themes
         (§2.1). The ring is 3 px rather than the panes' 2, drawn 4 px outside the control so it never
         touches the glyph, because a pill floating over a customer's desktop has the busiest background
         in the product. High contrast maps all three to system colours through its dictionary. -->
    <Style x:Key="FocusRing.Frame">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4"
                            BorderBrush="{DynamicResource Brush.shell.accent}"
                            BorderThickness="3"
                            CornerRadius="{DynamicResource Radius.pill}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round 32 px icon button on the pill: Mark, Pause, Stop and the chevron. Named and tool-tipped by
         the caller (name and hotkey, "Pause · Ctrl+Alt+P"). -->
    <Style x:Key="Hud.IconButton" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="Height" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.shell.bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.bg}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Frame}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.Placement" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.pill}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.muted}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A worded button on the expanded pill (Mark moment, Open in ScreenTail): outlined in shell.muted,
         32 px tall, the control radius. -->
    <Style x:Key="Hud.TextButton" BasedOn="{StaticResource Hud.IconButton}" TargetType="Button">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.muted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Table: 36 px rows, a quiet header, a tint on hover and on the selected row. The tint, the accent
         mark at the row's leading edge and the keyboard focus outline are the row's, not its cells', so each
         runs the whole width of the table whatever the columns add up to (v0.6.6). High contrast selects
         the system way, highlight on highlight text, because its tint is the window colour; the mark stays
         where the fill is not drawn. -->
    <!-- A table's row, keyed so a table can name its rows for a screen reader on top of it (ST-084).
         Keyboard focus in a DataGrid sits on a cell. With whole rows selected the row is what is acted on,
         so the outline is drawn round the row (RowFocus says when focus is in it and came by keyboard):
         2 px accent.primary, inside the row's edge, because a ring outside it is cut off by the table's
         edge and by the rows above and below. BorderBrush is the outline's colour and nothing else. -->
    <Style x:Key="Table.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="controls:RowFocus.Track" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid>
                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <DataGridDetailsPresenter Grid.Row="1"
                                                          Grid.Column="1"
                                                          SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                          Visibility="{TemplateBinding DetailsVisibility}" />
                                <DataGridRowHeader Grid.RowSpan="2"
                                                   SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                                   Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </SelectiveScrollingGrid>
                        </Border>
                        <Rectangle x:Name="Indicator"
                                   Width="3"
                                   Height="{DynamicResource Icon.control}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Fill="{DynamicResource Brush.accent.primary}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                        <!-- Over the cells, the grid line along the row's bottom edge included. -->
                        <Rectangle x:Name="FocusOutline"
                                   RadiusX="4"
                                   RadiusY="4"
                                   SnapsToDevicePixels="True"
                                   Stroke="{TemplateBinding BorderBrush}"
                                   StrokeThickness="{DynamicResource Focus.width}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="controls:RowFocus.Shown" Value="True">
                            <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
            </Trigger>
            <!-- After hover, so a selected row under the pointer stays the selection's tint. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.selected}" />
            </Trigger>
            <!-- High contrast: the system's selection, and the outline in its text colour so it shows on it. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.text.on-accent}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Table" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="{DynamicResource Layout.row-height}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
                    <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
                    <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="Height" Value="{DynamicResource Layout.row-height}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                    <!-- Spec §3 makes the table sortable, and a header is how it sorts. WPF's headers take no
                         focus, so sorting needed the mouse (ST-084); focusable, Space or Enter sorts. -->
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- The filler WPF adds after the last column is no column and sorts nothing. -->
                        <DataTrigger Binding="{Binding Column, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <!-- The ring is cut off at the table's top edge, so the focused header is drawn in
                             the accent with its words in the accent's text colour, as high contrast draws a
                             selection: an underline alone was too faint on a scaled screen (ST-084). -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.on-accent}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle" Value="{StaticResource Table.Row}" />
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                    <!-- The row draws the keyboard focus outline (Table.Row); a ring round one cell said the
                         cell was the thing acted on, and was cut off at the table's edge. -->
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- The selection's fill is the row's. In high contrast the words take its text colour. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.on-accent}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Split pane: resizable; a 1 px rule in a grip as wide as Spec §7's smallest target, so it is easy to
         catch and quiet to look at. The grip is the gap between two panes, never over them (ST-084). -->
    <Style x:Key="SplitPane.Splitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle x:Name="Rule" Width="1" HorizontalAlignment="Center" Fill="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rule" Property="Width" Value="2" />
                            <Setter TargetName="Rule" Property="Fill" Value="{DynamicResource Brush.accent.primary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Rule" Property="Width" Value="2" />
                            <Setter TargetName="Rule" Property="Fill" Value="{DynamicResource Brush.accent.primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filmstrip: 160×90 thumbnails with their label underneath; selected = accent outline and tint,
         excluded = dimmed image plus the word (the item template's). The container is sized by its content:
         a fixed 160×90 container cut the label off, so "excluded" was shown by opacity alone. -->
    <Style x:Key="Filmstrip" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <!-- The strip's items are StripItems; a screen reader says SpokenName (ST-084). -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Frame"
                                        MinWidth="176"
                                        MinHeight="106"
                                        Padding="{TemplateBinding Padding}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="2"
                                        CornerRadius="{DynamicResource Radius.card}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                                    </Trigger>
                                    <!-- Keyboard focus outlines the frame in the accent (ST-084): the focus ring is
                                         drawn in the list's scrolling layer and is cut off at its edges. -->
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Timeline scrubber (collapsed height 40; ST-076 draws the markers) -->
    <Style x:Key="Timeline" TargetType="Border">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- v0.6.4 (Outbox): the workspace frame and the inbox rail (Spec §5 S3, S4). They sit on
         shell.bg, so they take the frame's tokens: shell.text and shell.muted for words, shell.hover under
         the pointer, and keyboard focus as a 3 px shell.accent ring outside the control, which is 4.5:1 or
         more on shell.bg and shell.hover in both themes where the panes' 2 px accent.primary is 2.80:1 on
         the light frame (§2.1). The open session's row is the session pane's tab: it takes the pane's
         bg.base and content tokens, the 4 px brand.ribbon.band over it, and a 1 px shell.accent edge, which
         is the Highlight outline that stays in high contrast, where the band is the window colour. -->
    <Style x:Key="FocusRing.Rail">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4"
                            BorderBrush="{DynamicResource Brush.shell.accent}"
                            BorderThickness="3"
                            CornerRadius="8"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Text.Frame" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
    </Style>
    <Style x:Key="Text.FrameMuted" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
    </Style>

    <!-- The capture state on the frame (Spec §3, status chip): the words in shell.text, the dot and the
         border in the shell.* colour of the state. -->
    <Style x:Key="Badge.Frame" BasedOn="{StaticResource Badge.Status}" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Brush.shell.bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.offline}" />
    </Style>

    <!-- The rail's search: a field on the frame, its edge in shell.muted (3:1 and more on shell.bg). -->
    <Style x:Key="Rail.Search" TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="32,0,12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.shell.accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.muted}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.shell.accent}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group's list: no chrome and no scroller of its own, since the rail scrolls as a whole. Not a
         stop itself: Tab lands on its open row, or its first, and the arrows move from there. -->
    <Style x:Key="Rail.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A rail row. On the frame at rest; under the pointer shell.hover; the open session's row is the
         pane's tab (see the note above the frame's styles). -->
    <Style x:Key="Rail.Row" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="8,4,0,4" />
        <Setter Property="Padding" Value="12,8,16,8" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- Both set here, so the theme's own item style never binds them to an ancestor list that a row
             being taken out of the rail no longer has. -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
        <Setter Property="IsSelected" Value="{Binding IsOpen, Mode=OneWay}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1,1,0,1"
                                CornerRadius="6,0,0,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Band"
                                Height="4"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.brand.ribbon.band}"
                                CornerRadius="6,0,0,0"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.shell.hover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.base}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.shell.accent}" />
                            <Setter TargetName="Band" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row's words: shell.text and shell.muted on the frame, text.primary and text.secondary on the tab. -->
    <Style x:Key="Rail.RowTitle" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Rail.RowMeta" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A row's state badge: the word in the row's body colour, a neutral edge, and the hue in its glyph. -->
    <Style x:Key="Rail.Badge" BasedOn="{StaticResource Badge}" TargetType="ContentControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.muted}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="Padding" Value="4,0,8,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Rail.BadgeGlyph" BasedOn="{StaticResource Icon}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.xs}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding BadgeTone}" Value="Published">
                <Setter Property="Foreground" Value="{DynamicResource Brush.shell.published}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BadgeTone}" Value="Paused">
                <Setter Property="Foreground" Value="{DynamicResource Brush.shell.paused}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BadgeTone}" Value="Offline">
                <Setter Property="Foreground" Value="{DynamicResource Brush.shell.offline}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsOpen}" Value="True" />
                    <Condition Binding="{Binding BadgeTone}" Value="Muted" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsOpen}" Value="True" />
                    <Condition Binding="{Binding BadgeTone}" Value="Published" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.state.published}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsOpen}" Value="True" />
                    <Condition Binding="{Binding BadgeTone}" Value="Paused" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsOpen}" Value="True" />
                    <Condition Binding="{Binding BadgeTone}" Value="Offline" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.state.offline}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A group's heading that opens and closes it (Earlier). -->
    <Style x:Key="Rail.GroupToggle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The rail's foot: All sessions, Settings, Diagnostics. Tag="Selected" marks the view the pane shows,
         with shell.hover and a 3 px shell.accent bar at the left edge, so it is shape and not colour alone. -->
    <Style x:Key="Rail.FootItem" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.row-height}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Rectangle x:Name="Indicator"
                                   Width="3"
                                   Height="16"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Fill="{DynamicResource Brush.shell.accent}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.shell.hover}" />
                            <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A link on the frame (the rail's Clear search): shell.accent, underlined under the pointer. -->
    <Style x:Key="Rail.Link" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.control}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- v0.6.7 (Spec §2.0): the horizontal lockup on the frame, drawn from
         shared/design/brand/lockup-horizontal-on-navy.svg on its own 330.4 by 96 grid, clear space
         included, so it scales with the box it is given and is sharp at any DPI. The file's colours are the
         tokens' (§2.0: nothing in the app uses a brand hex): the ribbon brand.signature, its underside and
         the long note line shell.text (paper), the dots and the short line shell.accent (Ribbon 400), the
         wordmark shell.text, all on shell.bg. The file knocks the screen's surround out of the ribbon with
         a mask; here a shell.bg plate is drawn over the ribbon instead, which is the same picture on a flat
         frame, and the screen is the frame's own colour. In high contrast the ribbon and the word are the
         window text, the screen is knocked out, and the dots take the highlight colour. Decoration: the window's
         title and the step's heading name the app, so it has no automation peer and takes no focus. -->
