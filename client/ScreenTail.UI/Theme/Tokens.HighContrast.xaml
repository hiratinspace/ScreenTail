<!-- Spec §7: when Windows high contrast is on, every token maps to the system palette the user chose.
     Same keys as the generated theme dictionaries, so components need no changes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="Token.bg.base">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.base" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.bg.surface">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.surface" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.bg.raised">{x:Static SystemColors.ControlColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.raised" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <!-- The tints (v0.5) are all the window colour here. A tinted fill is how light and dark show hover,
         selection and a banner's kind; high contrast shows them with the border and the words instead,
         because a system palette has no tint that is guaranteed to keep WindowText readable on it. -->
    <Color x:Key="Token.bg.hover">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.hover" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.bg.pressed">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.pressed" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.bg.selected">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.selected" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.bg.warning">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.warning" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.bg.danger">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.danger" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.bg.success">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.bg.success" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.border.subtle">{x:Static SystemColors.ActiveBorderColor}</Color>
    <SolidColorBrush x:Key="Brush.border.subtle" Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}" />
    <Color x:Key="Token.border.strong">{x:Static SystemColors.WindowFrameColor}</Color>
    <SolidColorBrush x:Key="Brush.border.strong" Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />
    <!-- An input's edge: the same system frame colour the inputs used before border.control existed. -->
    <Color x:Key="Token.border.control">{x:Static SystemColors.WindowFrameColor}</Color>
    <SolidColorBrush x:Key="Brush.border.control" Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />
    <Color x:Key="Token.text.primary">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.text.primary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.text.secondary">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.text.secondary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.text.muted">{x:Static SystemColors.GrayTextColor}</Color>
    <SolidColorBrush x:Key="Brush.text.muted" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <Color x:Key="Token.accent.primary">{x:Static SystemColors.HighlightColor}</Color>
    <SolidColorBrush x:Key="Brush.accent.primary" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <Color x:Key="Token.accent.primary.hover">{x:Static SystemColors.HotTrackColor}</Color>
    <SolidColorBrush x:Key="Brush.accent.primary.hover" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <Color x:Key="Token.state.recording">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.state.recording" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.state.paused">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.state.paused" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.state.scope">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.state.scope" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.state.published">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.state.published" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.state.offline">{x:Static SystemColors.GrayTextColor}</Color>
    <SolidColorBrush x:Key="Brush.state.offline" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <Color x:Key="Token.state.danger">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.state.danger" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.confidence.low">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.confidence.low" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.text.on-accent">{x:Static SystemColors.HighlightTextColor}</Color>
    <SolidColorBrush x:Key="Brush.text.on-accent" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <!-- v0.6.0 brand. The signature is a rule or a mark, so it takes the text colour. The ribbon band and its
         fold are decoration: drawn in the window colour they are not seen, and the selected tab keeps its
         Highlight outline, so nothing depends on them. -->
    <Color x:Key="Token.brand.signature">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.brand.signature" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.brand.ribbon.band">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.brand.ribbon.band" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.brand.ribbon.fold">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.brand.ribbon.fold" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <!-- v0.6.0 frame (rail, title bar, pill). High contrast has no frame of its own: it is the window, with
         the window text on it, and each state keeps its word and glyph. -->
    <Color x:Key="Token.shell.bg">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.bg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.shell.hover">{x:Static SystemColors.WindowColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.hover" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <Color x:Key="Token.shell.text">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.text" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.shell.muted">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.muted" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.shell.accent">{x:Static SystemColors.HighlightColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.accent" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <Color x:Key="Token.shell.line">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.line" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.shell.recording">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.recording" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.shell.paused">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.paused" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.shell.published">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.published" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.shell.scope">{x:Static SystemColors.WindowTextColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.scope" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <Color x:Key="Token.shell.offline">{x:Static SystemColors.GrayTextColor}</Color>
    <SolidColorBrush x:Key="Brush.shell.offline" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <sys:String x:Key="Token.theme">high-contrast</sys:String>
    <sys:Boolean x:Key="Token.elevation.enabled">False</sys:Boolean>
</ResourceDictionary>
