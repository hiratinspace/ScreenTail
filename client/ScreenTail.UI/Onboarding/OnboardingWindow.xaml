<Window x:Class="ScreenTail.UI.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:activation="clr-namespace:ScreenTail.UI.Settings.Activation"
        xmlns:integrations="clr-namespace:ScreenTail.UI.Settings.Integrations"
        xmlns:local="clr-namespace:ScreenTail.UI.Onboarding"
        Title="Set up ScreenTail"
        Width="820"
        Height="640"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Window.Base}">
    <Grid Background="{DynamicResource Brush.bg.base}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Progress dots at the top (Spec §5 S8). -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Dots}" HorizontalAlignment="Center" AutomationProperties.Name="Progress">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Margin="4,0" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.accent.primary}" Text="{Binding Mark}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="1" Margin="0,12,0,12" Style="{StaticResource Text.ScreenTitle}" Text="{Binding Title}" AutomationProperties.LiveSetting="Polite" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- 1. Welcome -->
                <StackPanel Visibility="{Binding WelcomeVisibility}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="ScreenTail watches your remote-support sessions and drafts the ticket note for you: what you did, in order, with the screenshots that show it." />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.SectionHeading}" Text="Nothing is published without your review." />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="Setup takes about five minutes: activate this device, check what the machine allows, pick your remote tools, connect your PSA if you want to, and try a session." />
                </StackPanel>

                <!-- 2. Activate: the code from the invite; the tenant's name on success. -->
                <activation:ActivationPane Visibility="{Binding ActivateVisibility}" DataContext="{Binding Activation}" />

                <!-- 3. Permissions: each shows ✓ or a fix. -->
                <StackPanel Visibility="{Binding PermissionsVisibility}">
                    <ItemsControl ItemsSource="{Binding Permissions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" Text="{Binding Mark}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Label}" />
                                            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding Message}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Fix in Windows Settings"
                                                Command="{Binding DataContext.OpenFixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding FixLink}"
                                                Visibility="{Binding FixLink, Converter={x:Static local:NullToCollapsed.Instance}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Content="Check again" Command="{Binding RecheckCommand}" />
                </StackPanel>

                <!-- 4. Your remote tools -->
                <StackPanel Visibility="{Binding ToolsVisibility}">
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="A session starts when one of these takes focus. Capture is limited to the remote tool's windows and your admin tools (Recommended); that can be changed later in Settings → Capture." />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,0,0,6" Content="{Binding DisplayName}" IsChecked="{Binding Enabled}" Foreground="{DynamicResource Brush.text.primary}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Content="Save" Command="{Binding SaveToolsCommand}" />
                </StackPanel>

                <!-- 5. Connect (skippable) -->
                <integrations:IntegrationsPane Visibility="{Binding ConnectVisibility}" DataContext="{Binding Integrations}" />

                <!-- 6. Try it: a real session, drafted the real way. -->
                <StackPanel Visibility="{Binding TryItVisibility}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="A sixty-second test: start, open any window, click around, say one sentence, then stop. The draft opens in Review when it is ready." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Start test session" Command="{Binding StartTestCommand}" IsEnabled="{Binding CanStartTest}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" Content="Stop and draft" Command="{Binding StopTestCommand}" IsEnabled="{Binding TestRunning}" />
                    </StackPanel>
                </StackPanel>

                <!-- 7. Done -->
                <StackPanel Visibility="{Binding DoneVisibility}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="ScreenTail starts when you open a remote session. Look for the pill. Everything here can be changed in Settings, and this setup can be run again from the tray." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding Note}" Visibility="{Binding NoteVisibility}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding Blocker}" Visibility="{Binding BlockerVisibility}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Button HorizontalAlignment="Left" Style="{StaticResource Button.Ghost}" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Ghost}" Content="Skip for now" Command="{Binding SkipCommand}" Visibility="{Binding SkipVisibility}" />
                <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="Continue" Command="{Binding NextCommand}" IsEnabled="{Binding CanContinue}" Visibility="{Binding ContinueVisibility}" />
                <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="Finish" Command="{Binding FinishCommand}" Visibility="{Binding FinishVisibility}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
