<UserControl x:Class="ScreenTail.UI.History.InboxRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenTail.UI.Controls"
             xmlns:core="clr-namespace:ScreenTail.Core.History;assembly=ScreenTail.Core">
    <!-- Spec v0.6.0 §5 S4, as built v0.6.4: the inbox rail. Search, then the groups in order with their
         counts, each a list a screen reader hears by its name and count. Its foot (All sessions, Settings,
         Diagnostics) is the shell's, below this view. -->
    <UserControl.Resources>
        <!-- One row: what it is and how long ago on the first line, how long and how many screenshots on the
             second, and a state badge where the group does not already say it. -->
        <DataTemplate x:Key="Rail.RowTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Rail.RowTitle}" Text="{Binding Title}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Rail.RowMeta}" Text="{Binding Age}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,0,0" VerticalAlignment="Center" Style="{StaticResource Rail.RowMeta}" Text="{Binding Meta}" />
                <ContentControl Grid.Row="1"
                                Grid.Column="1"
                                Margin="8,4,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Rail.Badge}"
                                Visibility="{Binding BadgeVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph Style="{StaticResource Rail.BadgeGlyph}" Text="{Binding BadgeGlyph}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding Badge}" />
                    </StackPanel>
                </ContentControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search over what the rows say (Ctrl+F). The hint sits behind the text and goes once anything is typed. -->
        <Grid Grid.Row="0" Margin="16,16,16,8">
            <controls:Glyph Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            Panel.ZIndex="1"
                            IsHitTestVisible="False"
                            Style="{StaticResource Icon}"
                            Foreground="{DynamicResource Brush.shell.muted}"
                            Text="&#xE721;" />
            <TextBlock Margin="32,0,12,0"
                       VerticalAlignment="Center"
                       Panel.ZIndex="1"
                       IsHitTestVisible="False"
                       Style="{StaticResource Text.FrameMuted}"
                       FontSize="{DynamicResource Size.md}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Visibility="{Binding SearchHintVisibility}"
                       Text="{x:Static core:InboxRail.SearchHint}" />
            <TextBox x:Name="Search"
                     Style="{StaticResource Rail.Search}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search sessions"
                     AutomationProperties.HelpText="{x:Static core:InboxRail.SearchHelp}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Focusable="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,8">
                <!-- Nothing to list: asking, not answered, no sessions yet, or nothing matches the search. -->
                <StackPanel Margin="16,8,16,8" Visibility="{Binding NoticeVisibility}">
                    <TextBlock Style="{StaticResource Text.FrameMuted}"
                               Text="{Binding Notice}"
                               controls:LiveRegion.Setting="Polite" />
                    <Button Margin="-4,8,0,0"
                            Style="{StaticResource Rail.Link}"
                            Content="Clear search"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding ClearSearchVisibility}" />
                </StackPanel>

                <controls:Repeater ItemsSource="{Binding Groups}">
                    <controls:Repeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding Visibility}">
                                <!-- The heading: words and the count, or for Earlier a toggle that opens it. -->
                                <!-- In line with the rows' words: the rail's 8 inset, then the row's 12. -->
                                <StackPanel Margin="8,0,16,4"
                                            Orientation="Horizontal"
                                            Visibility="{Binding HeaderTextVisibility}">
                                    <TextBlock Margin="12,0,0,0"
                                               Style="{StaticResource Text.Frame}"
                                               FontSize="{DynamicResource Size.sm}"
                                               FontWeight="{DynamicResource Weight.semibold}"
                                               Text="{Binding Name}" />
                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.FrameMuted}" Text="{Binding CountText}" />
                                </StackPanel>
                                <ToggleButton Margin="12,0,16,4"
                                              Style="{StaticResource Rail.GroupToggle}"
                                              IsChecked="{Binding IsExpanded}"
                                              Visibility="{Binding ToggleVisibility}"
                                              AutomationProperties.Name="{Binding Heading}"
                                              AutomationProperties.HelpText="Shows or hides the older sessions.">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Glyph Style="{StaticResource Icon}"
                                                        FontSize="{DynamicResource Size.xs}"
                                                        Foreground="{DynamicResource Brush.shell.muted}"
                                                        Text="{Binding Chevron}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Style="{StaticResource Text.Frame}"
                                                   FontSize="{DynamicResource Size.sm}"
                                                   FontWeight="{DynamicResource Weight.semibold}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.FrameMuted}" Text="{Binding CountText}" />
                                    </StackPanel>
                                </ToggleButton>
                                <ListBox Style="{StaticResource Rail.List}"
                                         ItemsSource="{Binding Rows}"
                                         ItemContainerStyle="{StaticResource Rail.Row}"
                                         ItemTemplate="{StaticResource Rail.RowTemplate}"
                                         Visibility="{Binding RowsVisibility}"
                                         SelectionChanged="OnSelectionChanged"
                                         AutomationProperties.Name="{Binding Heading}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:Repeater.ItemTemplate>
                </controls:Repeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
