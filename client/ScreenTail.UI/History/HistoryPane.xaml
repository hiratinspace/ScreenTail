<UserControl x:Class="ScreenTail.UI.History.HistoryPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="History">
    <UserControl.Resources>
        <!-- The table when there are rows, the sentence as an empty state when there are none. -->
        <Style x:Key="History.Table" BasedOn="{StaticResource Table}" TargetType="DataGrid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="History.Count" BasedOn="{StaticResource Text.Secondary}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="History.Empty" BasedOn="{StaticResource Card}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid MaxWidth="1100" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header: the title, and the count beside it. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="History" />
            <TextBlock Margin="14,0,0,3"
                       VerticalAlignment="Bottom"
                       Style="{StaticResource History.Count}"
                       Text="{Binding Status}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  x:Name="Sessions"
                  Margin="0,16,0,0"
                  Style="{StaticResource History.Table}"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MouseDoubleClick="OnOpen"
                  AutomationProperties.Name="Sessions">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="180" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" />
                <!-- The status as a badge, the way the spec's table draws it; the words are the same. -->
                <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl HorizontalAlignment="Left" Style="{StaticResource Badge}" Content="{Binding Status}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="160" />
                <DataGridTextColumn Header="Screenshots" Binding="{Binding Frames}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nothing yet: the same sentence the count line says, as the screen's content. -->
        <Border Grid.Row="1"
                MaxWidth="560"
                Margin="0,0,0,48"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource History.Empty}">
            <StackPanel>
                <Border Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.bg.selected}"
                        CornerRadius="28">
                    <TextBlock Style="{StaticResource EmptyState.Icon}"
                               Foreground="{DynamicResource Brush.accent.primary}"
                               Text="&#xE81C;" />
                </Border>
                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Text.Body}"
                           TextAlignment="Center"
                           Text="{Binding Status}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Style="{StaticResource Button.Primary}"
                    Content="Open"
                    Command="{Binding OpenCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=Sessions}" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Muted}"
                       Text="Or double-click a session to review it." />
        </StackPanel>
    </Grid>
</UserControl>
