<UserControl x:Class="ScreenTail.UI.History.HistoryPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenTail.UI.Controls"
             AutomationProperties.Name="History">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- What the last discard did, unless it did not happen: then the reason is shown in its place. -->
        <Style x:Key="History.Notice" BasedOn="{StaticResource Text.Secondary}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DiscardFailed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The table when there are rows, the sentence as an empty state when there are none. -->
        <Style x:Key="History.Table" BasedOn="{StaticResource Table}" TargetType="DataGrid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="History.Count" BasedOn="{StaticResource Text.Secondary}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="History.Empty" BasedOn="{StaticResource Card}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid MaxWidth="1100" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header: the title, and the count beside it. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="History" />
            <TextBlock Margin="14,0,0,3"
                       VerticalAlignment="Bottom"
                       Style="{StaticResource History.Count}"
                       Text="{Binding Status}"
                       controls:LiveRegion.Setting="Polite" />
        </StackPanel>

        <!-- Extended: click, Shift and Ctrl with the mouse, Shift and Ctrl with the arrows and Space, and
             Ctrl+A, the way every Windows table selects. Spec §5 S4: multi-select, then Bulk discard. -->
        <DataGrid Grid.Row="1"
                  x:Name="Sessions"
                  Margin="0,16,0,0"
                  Style="{StaticResource History.Table}"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnOpen"
                  AutomationProperties.Name="Sessions"
                  AutomationProperties.HelpText="Select one or more sessions with Shift or Ctrl, then choose Bulk discard.">
            <!-- The table's row style with each row named for a screen reader (ST-084). -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource Table.Row}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="180" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" />
                <!-- The status as a badge, the way the spec's table draws it; the words are the same. -->
                <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl HorizontalAlignment="Left" Style="{StaticResource Badge}" Content="{Binding Status}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="160" />
                <DataGridTextColumn Header="Screenshots" Binding="{Binding Frames}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nothing yet: the same sentence the count line says, as the screen's content. -->
        <Border Grid.Row="1"
                MaxWidth="560"
                Margin="0,0,0,48"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource History.Empty}">
            <StackPanel>
                <Border Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.bg.selected}"
                        CornerRadius="28">
                    <controls:Glyph Style="{StaticResource EmptyState.Icon}"
                               Foreground="{DynamicResource Brush.accent.primary}"
                               Text="&#xE81C;" />
                </Border>
                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Text.Body}"
                           TextAlignment="Center"
                           Text="{Binding Status}"
                           controls:LiveRegion.Setting="Polite" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}"
                        Content="Open"
                        Command="{Binding OpenCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=Sessions}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="Or double-click a session to review it." />
            </StackPanel>

            <!-- How many are selected and how many of those a discard would take, so the number the
                 dialog asks for is never a surprise. Then the button, on the right, apart from Open. -->
            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Margin="16,0,12,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Secondary}"
                       Text="{Binding SelectionNote}"
                       controls:LiveRegion.Setting="Polite" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource Button.Danger}"
                    Content="Bulk discard"
                    Command="{Binding BulkDiscardCommand}"
                    ToolTip="Discard the selected sessions. You will be asked to type how many."
                    AutomationProperties.Name="Bulk discard the selected sessions"
                    AutomationProperties.HelpText="Deletes the selected sessions' screenshots, transcripts and notes from this device. You will be asked to type how many." />

            <!-- What the last discard did, or why it did not happen: beside the button, never a dialog,
                 and read out as it changes. -->
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource Text.Error}"
                       Visibility="{Binding DiscardFailed, Converter={StaticResource Visible}}"
                       Text="{Binding DiscardError}"
                       controls:LiveRegion.Setting="Assertive" />
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource History.Notice}"
                       Text="{Binding Notice}"
                       controls:LiveRegion.Setting="Polite" />
        </Grid>
    </Grid>
</UserControl>
