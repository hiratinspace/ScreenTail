<UserControl x:Class="ScreenTail.UI.History.HistoryPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="History">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource Text.SectionHeading}"
                   Text="{Binding Status}"
                   AutomationProperties.LiveSetting="Polite" />

        <DataGrid Grid.Row="1"
                  x:Name="Sessions"
                  Margin="0,10,0,0"
                  Style="{StaticResource Table}"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MouseDoubleClick="OnOpen"
                  AutomationProperties.Name="Sessions">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="170" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="140" />
                <DataGridTextColumn Header="Screenshots" Binding="{Binding Frames}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource Button.Secondary}"
                    Content="Open"
                    Command="{Binding OpenCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=Sessions}" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Muted}"
                       Text="Double-click a session to review it." />
        </StackPanel>
    </Grid>
</UserControl>
