<UserControl x:Class="ScreenTail.UI.History.HistoryPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenTail.UI.Controls"
             xmlns:local="clr-namespace:ScreenTail.UI.History"
             xmlns:core="clr-namespace:ScreenTail.Core.History;assembly=ScreenTail.Core"
             AutomationProperties.Name="All sessions">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- What the last discard did, unless it did not happen: then the reason is shown in its place. -->
        <Style x:Key="History.Notice" BasedOn="{StaticResource Text.Secondary}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DiscardFailed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The table when there are rows, the sentence as an empty state when there are none. -->
        <Style x:Key="History.Table" BasedOn="{StaticResource Table}" TargetType="DataGrid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="History.Count" BasedOn="{StaticResource Text.Secondary}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="History.Empty" BasedOn="{StaticResource Card}" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The actions only when there is a session to act on: with none, the empty state's sentence
             is the whole screen, not beside an Open with nothing to open. -->
        <Style x:Key="History.Actions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A cell's words end in an ellipsis, not under the next column, when a column is too narrow for them. -->
        <Style x:Key="History.CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>
    <!-- Spec §5 S4, as built v0.6.6: the table takes the pane's width, and its Status column takes what the
         others leave, so the rows and the selection run from edge to edge. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header: the title, and the count beside it. Since v0.6.4 the rail is History; this table,
             opened from the rail's foot, is where several sessions are selected at once. -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="All sessions" />
                <TextBlock Margin="12,0,0,4"
                           VerticalAlignment="Bottom"
                           Style="{StaticResource History.Count}"
                           Text="{Binding Status}"
                           controls:LiveRegion.Setting="Polite" />
            </StackPanel>

            <!-- Spec v0.6.9 S4: the v0.5 filters (status, tool, and the date range as whole-day periods),
                 above the table they filter, once there is a session. They wrap rather than clip in a
                 narrow pane. Each list says what it filters by in its first entry ("Any status"). -->
            <WrapPanel Margin="0,16,0,0" Orientation="Horizontal" Visibility="{Binding FiltersVisibility}">
                <ComboBox Width="160"
                          Margin="0,0,8,8"
                          ItemsSource="{x:Static core:HistoryFilters.StatusChoices}"
                          SelectedItem="{Binding StatusChoice}"
                          AutomationProperties.Name="Filter by status" />
                <ComboBox Width="160"
                          Margin="0,0,8,8"
                          ItemsSource="{Binding ToolChoices}"
                          SelectedItem="{Binding ToolChoice}"
                          AutomationProperties.Name="Filter by tool" />
                <ComboBox Width="160"
                          Margin="0,0,8,8"
                          ItemsSource="{x:Static core:HistoryFilters.PeriodChoices}"
                          SelectedItem="{Binding PeriodChoice}"
                          AutomationProperties.Name="Filter by when the session started" />
                <Button Margin="0,0,0,8"
                        Style="{StaticResource Button.Link}"
                        Content="Clear filters"
                        Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding ClearFiltersVisibility}" />
            </WrapPanel>
        </StackPanel>

        <!-- Extended: click, Shift and Ctrl with the mouse, Shift and Ctrl with the arrows and Space, and
             Ctrl+A, the way every Windows table selects. Spec §5 S4: multi-select, then Bulk discard. -->
        <DataGrid Grid.Row="1"
                  x:Name="Sessions"
                  Margin="0,8,0,0"
                  Style="{StaticResource History.Table}"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnOpen"
                  PreviewKeyDown="OnTableKeyDown"
                  AutomationProperties.Name="Sessions"
                  AutomationProperties.HelpText="Enter opens the session. Select one or more sessions with Shift or Ctrl, then choose Bulk discard.">
            <!-- The table's row style with each row named for a screen reader (ST-084). -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource Table.Row}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- The four worded columns are as wide as their longest words; with Status at its least they add
                     up to 656, which the pane holds at the window's 1024 minimum beside a scroll bar. -->
                <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="152" ElementStyle="{StaticResource History.CellText}" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" ElementStyle="{StaticResource History.CellText}" />
                <!-- The status as a badge in the rail's word, glyph and hue (spec v0.6.9 S4), so a state reads
                     the same on both and never by colour alone. -->
                <!-- "Not confirmed" sits beside the status, never in place of it: a publish of the session may
                     have reached the ticket, and the session is still a draft or published in part. Not
                     focusable, so it is no tab stop; the row's own name says it to a screen reader. -->
                <DataGridTemplateColumn Header="Status" Width="*" MinWidth="168" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Badge.State}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Glyph Style="{StaticResource Badge.StateGlyph}" Text="{Binding StatusGlyph}" />
                                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding Status}" />
                                    </StackPanel>
                                </ContentControl>
                                <ContentControl Margin="8,0,0,0"
                                                Padding="4,0,8,0"
                                                Style="{StaticResource Badge.Unconfirmed}"
                                                Visibility="{Binding NotConfirmedVisibility}"
                                                ToolTip="A publish of this session may have reached the ticket. Check the ticket, then publish again from Review or mark it as published."
                                                AutomationProperties.Name="Publish not confirmed">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Glyph Style="{StaticResource Icon}"
                                                        FontSize="{DynamicResource Size.xs}"
                                                        Foreground="{DynamicResource Brush.state.paused}"
                                                        Text="{x:Static local:HistoryRow.NotConfirmedGlyph}" />
                                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding NotConfirmedLabel}" />
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="136" ElementStyle="{StaticResource History.CellText}" />
                <DataGridTextColumn Header="Screenshots" Binding="{Binding Frames}" Width="120" ElementStyle="{StaticResource History.CellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nothing yet: the same sentence the count line says, as the screen's content. -->
        <Border Grid.Row="1"
                MaxWidth="560"
                Margin="0,0,0,40"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource History.Empty}">
            <StackPanel>
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <Ellipse Fill="{DynamicResource Brush.bg.selected}" />
                    <controls:Glyph Style="{StaticResource EmptyState.Icon}"
                                    Foreground="{DynamicResource Brush.accent.primary}"
                                    Text="&#xE81C;" />
                </Grid>
                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Text.Body}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding Status}"
                           controls:LiveRegion.Setting="Polite" />
                <Button Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Button.Link}"
                        Content="Clear filters"
                        Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding ClearFiltersVisibility}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource History.Actions}">
                <Button Style="{StaticResource Button.Primary}"
                        Content="Open"
                        Command="{Binding OpenCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=Sessions}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           Text="Or press Enter, or double-click a session." />
            </StackPanel>

            <!-- How many are selected and how many of those a discard would take, so the number the
                 dialog asks for is never a surprise. Then the button, on the right, apart from Open. -->
            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Margin="16,0,12,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Secondary}"
                       Text="{Binding SelectionNote}"
                       controls:LiveRegion.Setting="Polite" />
            <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource History.Actions}">
                <!-- For one selected session whose publish was not confirmed: the technician checked the
                     ticket and the note is there. Asks first, sends nothing to the ticket. -->
                <Button Margin="0,0,8,0"
                        Style="{StaticResource Button.Secondary}"
                        Content="Mark as published"
                        Command="{Binding MarkPublishedCommand}"
                        ToolTip="For one session marked Not confirmed: after checking the ticket, record that the earlier publish is there. Nothing is sent again."
                        AutomationProperties.Name="Mark as published: the selected session"
                        AutomationProperties.HelpText="For one selected session marked Not confirmed. After you have checked the ticket, records that the earlier publish is there. Nothing is sent again. You will be asked to confirm." />
                <Button Style="{StaticResource Button.Danger}"
                        Content="Bulk discard"
                        Command="{Binding BulkDiscardCommand}"
                        ToolTip="Discard the selected sessions. You will be asked to type how many."
                        AutomationProperties.Name="Bulk discard the selected sessions"
                        AutomationProperties.HelpText="Deletes the selected sessions' screenshots, transcripts and notes from this device. You will be asked to type how many." />
            </StackPanel>

            <!-- What the last discard did, or why it did not happen: beside the button, never a dialog,
                 and read out as it changes. -->
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource Text.Error}"
                       Visibility="{Binding DiscardFailed, Converter={StaticResource Visible}}"
                       Text="{Binding DiscardError}"
                       controls:LiveRegion.Setting="Assertive" />
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource History.Notice}"
                       Text="{Binding Notice}"
                       controls:LiveRegion.Setting="Polite" />
        </Grid>
    </Grid>
</UserControl>
