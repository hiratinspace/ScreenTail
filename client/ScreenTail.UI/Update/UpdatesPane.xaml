<UserControl x:Class="ScreenTail.UI.Update.UpdatesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:ScreenTail.Core.Settings;assembly=ScreenTail.Core"
             AutomationProperties.Name="Updates">
    <!-- ST-113, in the same cards, text styles and controls as the other Settings groups (#228): where
         this installation stands with Install, offered only when an update is ready and no session is
         recording; and the channel, locked with who set it when the admin's policy chose it (INV-11). -->
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="This installation" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap"
                           Text="{Binding Sentence}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="{Binding Installed}" />

                <Button Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Button.Primary}"
                        Content="Install update"
                        Command="{Binding InstallCommand}"
                        IsEnabled="{Binding CanInstall}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap"
                           Text="{x:Static core:UpdatesPanel.WhatInstallDoes}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource Text.Error}"
                           TextWrapping="Wrap"
                           Text="{Binding Problem}"
                           Visibility="{Binding ProblemVisibility}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Channel" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="Which releases this installation follows." />
                <RadioButton Margin="0,8,0,0" GroupName="UpdateChannel" Content="Stable (Recommended)" IsChecked="{Binding Stable}" IsEnabled="{Binding ChannelEditable}" />
                <RadioButton Margin="0,4,0,0" GroupName="UpdateChannel" Content="Pilot: each release first, before everyone else" IsChecked="{Binding Pilot}" IsEnabled="{Binding ChannelEditable}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="{Binding LockedNote}" Visibility="{Binding LockedVisibility}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
