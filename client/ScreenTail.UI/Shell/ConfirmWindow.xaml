<Window x:Class="ScreenTail.UI.Shell.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Style="{StaticResource Window.Base}">
    <!-- The app's one dialog (Spec §3 Modal, v0.6.11): the question, what follows, the phrase box when
         something irreversible is asked, and two buttons that say what each does. Esc presses the one that
         changes nothing. Where focus starts is set as it loads: in the phrase box when there is one (it
         was opened to type, ST-084), otherwise on Cancel when Enter must not act by reflex. -->
    <StackPanel Background="{DynamicResource Brush.bg.base}" Margin="{DynamicResource Padding.pane}">
        <TextBlock Style="{StaticResource Text.SectionHeading}" Text="{Binding Heading}" />

        <!-- What is actually lost, in the words a technician would use. A dialog that says "are you
             sure?" asks a question nobody can answer; this one says what disappears. -->
        <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Body}" Text="{Binding Consequence}" />

        <!-- Typed rather than clicked (Spec §3) for irreversible data loss. Input.Mono, not Text.Mono: that
             is a TextBlock style, and WPF refuses a style for another type the moment the window is built. -->
        <StackPanel x:Name="TypedPart" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock x:Name="Instruction" Margin="0,0,0,8" Style="{StaticResource Text.Label}" />
            <TextBox x:Name="Typed"
                     Style="{StaticResource Input.Mono}"
                     TextChanged="OnTyped"
                     AutomationProperties.Name="{Binding Text, ElementName=Instruction}" />
        </StackPanel>

        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="Cancel"
                    Style="{StaticResource Button.Secondary}"
                    Content="{Binding Cancel}"
                    IsCancel="True"
                    Click="OnCancel"
                    AutomationProperties.Name="{Binding Cancel}" />
            <Button x:Name="Confirm"
                    Margin="8,0,0,0"
                    Style="{StaticResource Button.Danger}"
                    Content="{Binding Action}"
                    Click="OnConfirm"
                    AutomationProperties.Name="{Binding Action}" />
        </StackPanel>
    </StackPanel>
</Window>
