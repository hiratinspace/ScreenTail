<Window x:Class="ScreenTail.UI.Shell.ShortcutSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenTail.UI.Controls"
        xmlns:shell="clr-namespace:ScreenTail.UI.Shell"
        Title="Keyboard shortcuts"
        Width="780"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}"
        Style="{StaticResource Window.Base}">
    <Window.Resources>
        <!-- One group: its heading, then a line per chord, the keys in the mono face. -->
        <DataTemplate x:Key="Sheet.Group">
            <StackPanel>
                <TextBlock Margin="0,16,0,6" Style="{StaticResource Text.Label}" Text="{Binding Name}" />
                <controls:Repeater ItemsSource="{Binding Chords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.text.primary}" Text="{Binding Keys}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Action}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <!-- Spec §4: ? opens a shortcut sheet. Every chord Spec §5 lists, grouped by where it works. Text, not
         controls: a screen reader reads it as a document, and Esc or Close puts the technician back. Two
         columns of groups, so the whole sheet fits a 768 px screen with Close on it: in one column Close fell
         off the bottom of the hosted runner's screen, and a sheet that scrolls cannot be scrolled from the
         keyboard when nothing in it takes focus (ST-084). -->
    <StackPanel Background="{DynamicResource Brush.bg.base}" Margin="{DynamicResource Padding.pane}">
        <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Keyboard shortcuts" />
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Repeater Grid.Column="0" ItemsSource="{x:Static shell:ShortcutSheet.LeftColumn}" ItemTemplate="{StaticResource Sheet.Group}" />
            <controls:Repeater Grid.Column="2" ItemsSource="{x:Static shell:ShortcutSheet.RightColumn}" ItemTemplate="{StaticResource Sheet.Group}" />
        </Grid>

        <Button x:Name="CloseButton"
                Margin="0,24,0,0"
                MinWidth="96"
                HorizontalAlignment="Right"
                Style="{StaticResource Button.Primary}"
                Content="Close"
                IsDefault="True"
                Click="OnClose"
                AutomationProperties.Name="Close the shortcut sheet" />
    </StackPanel>
</Window>
