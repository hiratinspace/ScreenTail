<Window x:Class="ScreenTail.UI.Shell.ShortcutSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenTail.UI.Controls"
        xmlns:shell="clr-namespace:ScreenTail.UI.Shell"
        Title="Keyboard shortcuts"
        Width="960"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}"
        Style="{StaticResource Window.Base}">
    <Window.Resources>
        <!-- A group's heading: the label style, as Settings' field names are, so the keys and their words
             stay the sheet's content. -->
        <Style x:Key="Sheet.GroupHeading" BasedOn="{StaticResource Text.Label}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>

        <!-- A key cap on the sheet (v0.6.11): the raised fill and the strong edge of a secondary button at
             rest, with the key in body colour, since here the keys are what is being read. No taller than a
             line of body text, so a line with caps is no taller than one without. -->
        <Style x:Key="KeyCap.Sheet" BasedOn="{StaticResource KeyCap}" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.text.primary}" />
        </Style>

        <!-- One group: its heading, then a line per chord, each key in its cap. -->
        <DataTemplate x:Key="Sheet.Group">
            <StackPanel>
                <TextBlock Style="{StaticResource Sheet.GroupHeading}" Text="{Binding Name}" />
                <controls:Repeater ItemsSource="{Binding Chords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Repeater Grid.Column="0" VerticalAlignment="Top" ItemsSource="{Binding Caps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource KeyCap.Sheet}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               Style="{StaticResource Text.KeyHint}"
                                                               FontSize="{DynamicResource Size.sm}"
                                                               Text="{Binding Key}" />
                                                </Border>
                                                <!-- The comma between alternatives is drawn, not read: each cap is read on its own. -->
                                                <controls:Glyph Margin="0,0,4,0"
                                                                VerticalAlignment="Bottom"
                                                                Style="{StaticResource Text.Muted}"
                                                                Text="{Binding After}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:Repeater>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Action}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <!-- Spec §4: ? opens a shortcut sheet. Every chord Spec §5 lists, grouped by where it works. Text, not
         controls: a screen reader reads it as a document, and Esc or Close puts the technician back. Two
         columns of groups, so the whole sheet fits a 768 px screen with Close on it: in one column Close fell
         off the bottom of the hosted runner's screen, and a sheet that scrolls cannot be scrolled from the
         keyboard when nothing in it takes focus (ST-084). 960 wide, within a 1024 px screen, so most lines take
         one line each: at 780 the step's Del line (v0.6.8) pushed Close off the bottom again. -->
    <StackPanel Background="{DynamicResource Brush.bg.base}" Margin="{DynamicResource Padding.pane}">
        <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Keyboard shortcuts" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Repeater Grid.Column="0" ItemsSource="{x:Static shell:ShortcutSheet.LeftColumn}" ItemTemplate="{StaticResource Sheet.Group}" />
            <controls:Repeater Grid.Column="2" ItemsSource="{x:Static shell:ShortcutSheet.RightColumn}" ItemTemplate="{StaticResource Sheet.Group}" />
        </Grid>

        <Button x:Name="CloseButton"
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource Button.Primary}"
                Content="Close"
                IsDefault="True"
                IsCancel="True"
                Click="OnClose"
                AutomationProperties.Name="Close the shortcut sheet" />
    </StackPanel>
</Window>
