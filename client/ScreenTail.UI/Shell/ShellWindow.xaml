<Window x:Class="ScreenTail.UI.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:review="clr-namespace:ScreenTail.UI.Review"
        xmlns:history="clr-namespace:ScreenTail.UI.History"
        Title="ScreenTail"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="680"
        Style="{StaticResource Window.Base}">
    <Window.Resources>
        <!-- The content area shows whatever the view model hands it, by type: a pane, or a sentence
             saying why there is none. Until 2026-09-25 it showed the pane's name. -->
        <DataTemplate DataType="{x:Type review:ReviewViewModel}">
            <review:ReviewPane />
        </DataTemplate>
        <DataTemplate DataType="{x:Type history:HistoryViewModel}">
            <history:HistoryPane />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sys:String}">
            <TextBlock Style="{StaticResource Text.Body}"
                       Foreground="{DynamicResource Brush.text.secondary}"
                       TextWrapping="Wrap"
                       Text="{Binding}"
                       AutomationProperties.LiveSetting="Polite" />
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource Brush.bg.base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Spec §5 S1: shown only when the service is not answering. A bar that is always there is a bar
             nobody reads, including on the day it says something that matters. -->
        <Border Grid.Row="0"
                Style="{StaticResource Banner.Warning}"
                Visibility="{Binding BannerVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Body}"
                           Text="{Binding Banner}"
                           AutomationProperties.LiveSetting="Assertive" />
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Secondary}"
                        Content="Start"
                        Command="{Binding StartServiceCommand}"
                        AutomationProperties.Name="Start the capture service" />
            </Grid>
        </Border>

        <!-- Navigation. Spec §5: Review, History, Settings. -->
        <Border Grid.Row="1" Padding="16,12" Background="{DynamicResource Brush.bg.raised}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource Pill.Control}"
                            Margin="0,0,8,0"
                            Content="Review"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Review" />
                    <Button Style="{StaticResource Pill.Control}"
                            Margin="0,0,8,0"
                            Content="History"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="History" />
                    <Button Style="{StaticResource Pill.Control}"
                            Content="Settings"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings" />
                </StackPanel>

                <!-- What the service says it is doing. Its own region so a screen reader is told when it
                     changes without the whole window being re-announced (Spec §7). -->
                <ContentControl Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource Badge}"
                                Content="{Binding Status}"
                                AutomationProperties.Name="Capture state"
                                AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Margin="16" Content="{Binding Content}" />
    </Grid>
</Window>
