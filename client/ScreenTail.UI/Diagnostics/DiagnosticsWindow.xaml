<Window x:Class="ScreenTail.UI.Diagnostics.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's being captured right now?"
        Width="360"
        Height="420"
        ResizeMode="NoResize"
        Style="{StaticResource Window.Base}">
    <Grid Background="{DynamicResource Brush.bg.base}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource Text.SectionHeading}"
                   Text="What's being captured right now?" />

        <!-- The one line a customer standing behind the technician needs to be able to read. -->
        <Border Grid.Row="1" Margin="0,10,0,12" Style="{StaticResource Banner.Info}">
            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource Text.Body}"
                       FontWeight="{DynamicResource Weight.semibold}"
                       Text="{Binding Headline}"
                       AutomationProperties.Name="Capture status"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Spec §5 S1 fixes the panel at 360x420 and there are twelve rows, so it has to scroll: without
             this the last two were drawn behind the Copy button and the technician simply never saw the
             client version. -->
        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Style="{StaticResource Card}"
                Padding="0">
            <ScrollViewer Padding="14,8,6,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Secondary}" FontSize="{DynamicResource Size.sm}" Text="{Binding Label}" />
                                <TextBlock Grid.Column="1"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource Text.Mono}"
                                           Foreground="{DynamicResource Brush.text.primary}"
                                           Text="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- States only, never content. The clipboard text is built from the diagnostics record alone. -->
        <Button Grid.Row="3"
                HorizontalAlignment="Left"
                Style="{StaticResource Button.Secondary}"
                Content="Copy diagnostics"
                Command="{Binding CopyCommand}"
                AutomationProperties.Name="Copy diagnostics to the clipboard" />
    </Grid>
</Window>
