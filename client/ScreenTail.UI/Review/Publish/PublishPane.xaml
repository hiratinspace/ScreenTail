<UserControl x:Class="ScreenTail.UI.Review.Publish.PublishPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             AutomationProperties.Name="Publish">
    <UserControl.Resources>
        <!-- A field's name, with the space above it that separates one group from the next. -->
        <Style x:Key="Publish.Field" BasedOn="{StaticResource Text.Label}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
    </UserControl.Resources>
    <Grid>

        <!-- Before publishing: the ticket, how the note goes, and where. The form scrolls; the button is
             pinned at the bottom of the pane, so the one primary action on the screen is always in view. -->
        <Grid Visibility="{Binding FormVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="20,18,20,4" Style="{StaticResource Text.SectionHeading}" Text="Publish" />

            <ScrollViewer Grid.Row="1"
                          Padding="20,0,14,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- ST-090: the backend's Development demo PSA, named where the technician is looking. -->
                    <Border Style="{StaticResource Banner.Info}"
                            Margin="0,10,0,0"
                            Visibility="{Binding DemoVisibility}"
                            AutomationProperties.Name="Demo PSA">
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding DemoNotice}" />
                    </Border>

                    <TextBlock Style="{StaticResource Publish.Field}" Margin="0,12,0,6" Text="Ticket" />
                    <TextBox Style="{StaticResource Input.Default}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             GotKeyboardFocus="OnTicketFocus"
                             AutomationProperties.Name="Search tickets"
                             AutomationProperties.HelpText="Recent tickets on focus; type three characters or a ticket number to search" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Muted}"
                               FontSize="{DynamicResource Size.xs}"
                               Text="{Binding MatchesHeading}"
                               Visibility="{Binding MatchesVisibility}" />
                    <ListBox MaxHeight="180"
                             Margin="0,4,0,0"
                             ItemsSource="{Binding Matches}"
                             SelectedItem="{Binding SelectedMatch}"
                             DisplayMemberPath="Label"
                             Visibility="{Binding MatchesVisibility}"
                             AutomationProperties.Name="Matching tickets" />
                    <WrapPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding TicketVisibility}">
                        <TextBlock Margin="0,0,8,0" Style="{StaticResource Text.Body}" Text="{Binding TicketLabel}" VerticalAlignment="Center" />
                        <ContentControl Style="{StaticResource Badge.Suggested}"
                                        VerticalAlignment="Center"
                                        Content="Suggested from window title"
                                        Visibility="{Binding SuggestedVisibility}" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Publish.Field}" Text="Note type" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Internal" IsChecked="{Binding IsInternal}" GroupName="NoteType" />
                        <RadioButton Margin="20,0,0,0" Content="Discussion" IsChecked="{Binding IsDiscussion}" GroupName="NoteType" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding DiscussionHint}" Margin="0,4,0,0" />

                    <TextBlock Style="{StaticResource Publish.Field}" Text="Time entry" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="80"
                                 Style="{StaticResource Input.Default}"
                                 Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Minutes" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Text="minutes" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" Text="{Binding RoundingNote}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Publish.Field}" Text="Destinations" />
                    <CheckBox Content="Ticket note" IsChecked="{Binding TicketNote}" />
                    <CheckBox Margin="0,2,0,0" Content="Time entry" IsChecked="{Binding TimeEntry}" />
                    <!-- The KB label carries its reason, so it wraps under the box rather than off the pane. -->
                    <CheckBox Margin="0,2,0,0" IsChecked="{Binding KbArticle}" AutomationProperties.Name="{Binding KbLabel}">
                        <TextBlock Margin="0,4" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding KbLabel}" />
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="20,14,20,16"
                    BorderBrush="{DynamicResource Brush.border.subtle}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <Button Style="{StaticResource Button.Primary}"
                            MinHeight="36"
                            HorizontalAlignment="Stretch"
                            Content="Publish   Ctrl+Enter"
                            Command="{Binding PublishCommand}"
                            IsEnabled="{Binding CanPublish}"
                            Visibility="{Binding PublishVisibility}"
                            AutomationProperties.HelpText="{Binding BlockedBecause}" />

                    <!-- v0.4.3: the reason beside the button, never only in a tooltip a keyboard user cannot reach. -->
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               Text="{Binding BlockedBecause}"
                               Visibility="{Binding BlockedVisibility}"
                               AutomationProperties.LiveSetting="Polite" />

                    <!-- No integration: the button is replaced, not disabled (Spec §5 S3). -->
                    <Border Style="{StaticResource Banner.Info}" Visibility="{Binding ConnectVisibility}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="{DynamicResource Weight.semibold}" Text="Connect a PSA to publish" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="Nothing can be published until a PSA is connected. Connect one in Settings, under Integrations." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- After publishing: what landed, where, and Retry for what did not. -->
        <ScrollViewer Padding="20,18,14,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ResultsVisibility}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Publish" />
                    <ContentControl Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Badge.Published}"
                                    Content="Published"
                                    Visibility="{Binding PublishedVisibility}" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0"
                           Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap"
                           Text="{Binding Summary}"
                           AutomationProperties.LiveSetting="Assertive" />
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Results}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- One row per destination: the mark and its name, then the link on its own line,
                                 so a long "Open in ConnectWise" never pushes the name off the pane. -->
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{DynamicResource Brush.bg.raised}"
                                    BorderBrush="{DynamicResource Brush.border.subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.control}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" FontWeight="{DynamicResource Weight.semibold}" Text="{Binding Mark}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Label}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" />
                                        <Button Margin="-10,4,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource Button.Ghost}"
                                                Foreground="{DynamicResource Brush.accent.primary}"
                                                Content="Open in ConnectWise"
                                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Link}"
                                                Visibility="{Binding LinkVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- ST-097 AC2: the article's company is not mapped, so ask once, here, and remember the answer.
                     Shown in place of Retry, which would only fail the same way. -->
                <Border Style="{StaticResource Banner.Warning}"
                        Margin="0,4,0,12"
                        Visibility="{Binding MappingVisibility}"
                        AutomationProperties.Name="Company mapping">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   Text="{Binding MappingPrompt}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ComboBox Margin="0,10,0,0"
                                  ItemsSource="{Binding Companies}"
                                  SelectedItem="{Binding SelectedCompany}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.Name="Company in the documentation platform" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Text.Error}"
                                   TextWrapping="Wrap"
                                   Text="{Binding MappingError}"
                                   Visibility="{Binding MappingErrorVisibility}"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button Margin="0,10,0,0"
                                Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Left"
                                Content="Map and publish the article"
                                Command="{Binding MapAndPublishCommand}"
                                IsEnabled="{Binding CanMap}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Left"
                        Content="Retry"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding RetryVisibility}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
