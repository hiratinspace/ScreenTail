<UserControl x:Class="ScreenTail.UI.Review.FilmstripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenTail.UI.Controls"
             xmlns:review="clr-namespace:ScreenTail.UI.Review"
             Background="Transparent"
             AutomationProperties.Name="Screenshots">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A screenshot. Excluded ones are dimmed *and* say "excluded" (Spec §7: never colour alone, and
             never opacity alone either) - and the word is outside the dimmed image, because fading the one
             signal that makes the state readable is how the first version of this lost it. -->
        <DataTemplate x:Key="FrameTemplate" DataType="{x:Type review:FrameItem}">
            <StackPanel Width="160">
                <Border Width="160"
                        Height="90"
                        CornerRadius="{DynamicResource Radius.control}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.border.subtle}"
                        Background="{DynamicResource Brush.bg.raised}"
                        ClipToBounds="True">
                    <!-- The glyph sits under the image: it shows while the thumbnail loads, and is covered
                         once it arrives. -->
                    <Grid>
                        <controls:Glyph HorizontalAlignment="Center"
                                   Style="{StaticResource Icon}"
                                   FontSize="20"
                                   Foreground="{DynamicResource Brush.text.muted}"
                                   Text="&#xEB9F;" />
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Label}" />
                    </Grid>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Included}" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                    <TextBlock Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.text.secondary}" Text="{Binding Label}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text=" · " />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding StateLabel}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- A stretch with no screenshots because capture was deliberately off. The same width as a frame
             so the strip keeps its rhythm, and dashed rather than merely tinted so it reads as a gap
             without relying on colour. -->
        <DataTemplate x:Key="GapTemplate" DataType="{x:Type review:GapItem}">
            <StackPanel Width="160">
                <Border Width="160"
                        Height="90"
                        CornerRadius="{DynamicResource Radius.control}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.state.paused}"
                        Background="{DynamicResource Brush.bg.surface}"
                        ToolTip="{Binding Description}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat" MappingMode="Absolute">
                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.5" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.5" Color="#40FFFFFF" />
                            <GradientStop Offset="1" Color="#40FFFFFF" />
                            <LinearGradientBrush.Transform>
                                <ScaleTransform ScaleX="8" />
                            </LinearGradientBrush.Transform>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding Duration}" />
                </Border>
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap"
                           Text="{Binding Description}" />
            </StackPanel>
        </DataTemplate>

        <review:StripItemTemplateSelector x:Key="StripTemplate"
                                          Frame="{StaticResource FrameTemplate}"
                                          Gap="{StaticResource GapTemplate}" />
    </UserControl.Resources>

    <Grid Margin="20,18,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="StripHeader" Grid.Row="0" Margin="0,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Text.SectionHeading}" Text="Screenshots" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Label}"
                           Text="{Binding Header}"
                           controls:LiveRegion.Setting="Polite" />
            </Grid>

            <!-- An exclusion or a delete the service did not record (S-35, T-136). Said in words with a
                 glyph, never colour alone (Spec §7), because the frame may be back next time. -->
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource Text.Body}"
                       Foreground="{DynamicResource Brush.state.danger}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasEditError, Converter={StaticResource Visible}}"
                       controls:LiveRegion.Setting="Assertive">
                <Run Text="⚠ " /><Run Text="{Binding EditError, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- PreviewKeyDown, not KeyDown: the ListBox's own key handling marks Space handled for selection
             before a KeyDown handler on it runs, so Space never excluded a frame (T-167). -->
        <ListBox Grid.Row="1"
                 x:Name="Strip"
                 Margin="-8,8,0,0"
                 Style="{StaticResource Filmstrip}"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected}"
                 SelectionChanged="OnStripSelectionChanged"
                 ItemTemplateSelector="{StaticResource StripTemplate}"
                 PreviewKeyDown="OnStripKeyDown"
                 MouseDoubleClick="OnStripDoubleClick"
                 AutomationProperties.Name="Screenshots" />

        <!-- The chords that apply to this pane, on screen where they are used (Spec §5 S3). -->
        <Grid x:Name="StripFooter" Grid.Row="2" Margin="0,8,6,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The 5 s undo, beside the strip rather than floating over it: a toast a technician has to
                 chase is a toast that expires while they are chasing it. -->
            <Border Grid.Column="0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource Toast}"
                    Visibility="{Binding HasUndoToast, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               Text="{Binding UndoToast}"
                               controls:LiveRegion.Setting="Assertive" />
                    <Button Margin="12,0,0,0"
                            Style="{StaticResource Button.Secondary}"
                            Content="Undo"
                            Command="{Binding UndoCommand}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Muted}"
                       FontSize="{DynamicResource Size.xs}"
                       Text="Space include · Enter enlarge · B blur · Del delete" />
        </Grid>

        <!-- Enlarged frame. Spans the pane, over everything, closed with Esc. While it is open the strip it
             covers is out of the Tab order and focus is on Close; Esc, T and B work from any of its
             controls, not only from the strip (ST-084). With the blur box out, Esc puts the box away
             first, and a second Esc closes the frame. -->
        <Border x:Name="EnlargedView"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="{DynamicResource Brush.bg.surface}"
                Visibility="{Binding IsEnlarged, Converter={StaticResource Visible}}"
                IsVisibleChanged="OnEnlargedVisibility"
                PreviewKeyDown="OnEnlargedKeyDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource Text.SectionHeading}"
                           Text="{Binding Enlarged.Label}" />

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <!-- TargetNullValue: the picture is bytes, dropped to null when the view lets go of it,
                         and without it WPF tries to convert that null and logs a binding error each time. -->
                    <Image x:Name="EnlargedImage"
                           Source="{Binding Enlarged.Image, TargetNullValue={x:Null}}"
                           Stretch="Uniform"
                           SizeChanged="OnBlurLayoutChanged"
                           AutomationProperties.Name="{Binding Enlarged.Label}" />

                    <!-- A blur of this frame with no answer yet (review of #257): no picture is shown, because
                         the one the service has may be from before it. Said instead of a blank. -->
                    <TextBlock Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               TextAlignment="Center"
                               Text="Waiting for the capture service to finish the last blur. The screenshot is hidden until it has."
                               Visibility="{Binding Enlarged.WaitingForBlur, Converter={StaticResource Visible}}" />

                    <!-- The blur surface. Transparent rather than absent, because a Canvas with no
                         background receives no mouse events at all and the drag would never start. -->
                    <Canvas x:Name="BlurSurface"
                            Background="Transparent"
                            Visibility="Collapsed"
                            SizeChanged="OnBlurLayoutChanged"
                            MouseLeftButtonDown="OnBlurDown"
                            MouseMove="OnBlurMove"
                            MouseLeftButtonUp="OnBlurUp">
                        <Rectangle x:Name="BlurRect"
                                   Visibility="Collapsed"
                                   Fill="#60000000"
                                   Stroke="{DynamicResource Brush.state.danger}"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 3" />

                        <!-- The keyboard's way to the same blur (ST-084 follow-up): B puts this box in the
                             middle of the picture with focus on it, the arrows move it, Shift with them
                             resizes it, Ctrl makes the steps bigger, Enter blurs what it covers and Esc puts
                             it away. Not hit-testable, so a drag that starts over it still draws. Outlined
                             in the window's own background colour under the dashes, so it shows on a light
                             screenshot and a dark one; focused, two more rings just inside it, one light and
                             one dark, for the same reason, each 3 px: over a dimmed light screenshot only the
                             dark one stands out at 3:1, so it alone has to carry the change, on a small box
                             too. Inside, so nothing drawn reaches past what is blurred: the outer edge of the
                             box is the edge of the blur. -->
                        <review:BlurBoxControl x:Name="KeyboardBox"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False"
                                               FocusVisualStyle="{x:Null}"
                                               AutomationProperties.Name="Region to blur"
                                               AutomationProperties.HelpText="The arrow keys move it. Shift with an arrow makes it wider, narrower, taller or shorter. Add Ctrl for bigger steps. Enter blurs everything inside its outer edge, which cannot be undone. Esc puts it away.">
                            <review:BlurBoxControl.Template>
                                <ControlTemplate TargetType="review:BlurBoxControl">
                                    <Grid>
                                        <Rectangle Fill="#60000000"
                                                   Stroke="{DynamicResource Brush.bg.base}"
                                                   StrokeThickness="3" />
                                        <Rectangle Stroke="{DynamicResource Brush.state.danger}"
                                                   StrokeThickness="2"
                                                   StrokeDashArray="4 3" />
                                        <Rectangle x:Name="FocusOuter"
                                                   Margin="3"
                                                   Stroke="{DynamicResource Brush.text.primary}"
                                                   StrokeThickness="3"
                                                   Visibility="Hidden" />
                                        <Rectangle x:Name="FocusInner"
                                                   Margin="6"
                                                   Stroke="{DynamicResource Brush.bg.base}"
                                                   StrokeThickness="3"
                                                   Visibility="Hidden" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </review:BlurBoxControl.Template>
                        </review:BlurBoxControl>
                    </Canvas>

                    <!-- What the redaction engine read off this frame. The point is verification: a
                         technician who can see the OCR text can tell a mask that worked from one that
                         missed, which is the only way INV-1 gets checked by a human. -->
                    <Border Background="{DynamicResource Brush.bg.surface}"
                            Padding="12"
                            Visibility="{Binding ShowOcrText, Converter={StaticResource Visible}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       TextWrapping="Wrap"
                                       Text="{Binding Enlarged.OcrText}" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,12">
                    <Button x:Name="CloseEnlarged"
                            Style="{StaticResource Button.Secondary}"
                            Content="Close  Esc"
                            Command="{Binding CloseEnlargedCommand}" />
                    <Button Margin="8,0,0,8"
                            Style="{StaticResource Button.Secondary}"
                            Content="OCR text  T"
                            Command="{Binding ToggleOcrTextCommand}"
                            IsEnabled="{Binding Enlarged.HasOcrText}" />

                    <!-- Danger styling, because the next drag destroys pixels for good. Spec §5 S3 asks
                         for a region-draw overlay and calls it destructive; the button says so before the
                         surface is even armed. -->
                    <ToggleButton x:Name="BlurMode"
                                  Margin="8,0,0,0"
                                  Content="Blur a region  B"
                                  Checked="OnBlurModeChanged"
                                  Unchecked="OnBlurModeChanged">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource Pill.Toggle}">
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.danger}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="Drag over what should be covered, or move the box with the arrow keys (Shift resizes) and press Enter. This cannot be undone."
                               Visibility="{Binding IsChecked, ElementName=BlurMode, Converter={StaticResource Visible}}" />
                </WrapPanel>

                <!-- Where the box is, in percent of the picture, said as it moves; then that the blur
                     landed. Numbers only: never what is under the box (INV-10). Set by the view. -->
                <TextBlock x:Name="BlurBoxStatus"
                           Grid.Row="3"
                           Margin="0,0,0,12"
                           Style="{StaticResource Text.Muted}"
                           Visibility="Collapsed"
                           controls:LiveRegion.Setting="Polite" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
