<Window x:Class="ScreenTail.UI.Review.ConfirmTypedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=Typed}"
        Style="{StaticResource Window.Base}">
    <StackPanel Background="{DynamicResource Brush.bg.base}" Margin="{DynamicResource Padding.pane}">
        <TextBlock Style="{StaticResource Text.SectionHeading}" TextWrapping="Wrap" Text="{Binding Heading}" />

        <!-- What is actually lost, in the words of the thing being lost. Spec §3: irreversible actions say
             what they destroy before they ask. -->
        <TextBlock Margin="0,12,0,0"
                   Style="{StaticResource Text.Body}"
                   TextWrapping="Wrap"
                   Text="{Binding Consequence}" />

        <TextBlock Margin="0,16,0,8" Style="{StaticResource Text.Label}" Text="{Binding Prompt}" />

        <!-- The caret is here when the dialog opens: the technician opened it to type. -->
        <TextBox x:Name="Typed"
                 Style="{StaticResource Input.Mono}"
                 TextChanged="OnTyped"
                 AutomationProperties.Name="{Binding Prompt}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource Button.Secondary}"
                    Margin="0,0,8,0"
                    Content="Keep it"
                    IsCancel="True"
                    Click="OnCancel"
                    AutomationProperties.Name="Keep it" />
            <Button x:Name="Confirm"
                    Style="{StaticResource Button.Danger}"
                    Content="{Binding Action}"
                    IsEnabled="False"
                    Click="OnConfirm"
                    AutomationProperties.Name="{Binding Action}" />
        </StackPanel>
    </StackPanel>
</Window>
