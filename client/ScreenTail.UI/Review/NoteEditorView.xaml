<UserControl x:Class="ScreenTail.UI.Review.NoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="clr-namespace:ScreenTail.UI.Review"
             Background="{DynamicResource Brush.bg.surface}"
             AutomationProperties.Name="Note">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Layout.pane-padding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Banners. Spec §7: never colour alone, so each carries a glyph and the kind as a word. -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Banners}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Banner.Info}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.paused}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Body}"
                                       Text="{Binding Glyph}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Muted}"
                                           FontSize="{DynamicResource Size.xs}"
                                           Text="{Binding Kind}" />
                                <TextBlock Style="{StaticResource Text.Body}"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           HorizontalAlignment="Left"
                                           Text="{Binding Text}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- v0.4.1 Q4: a failed draft says so and offers Retry. Writing a note by hand is v1.1, so there is
             no editor to fall back to, and an empty one would look like a note nobody wrote. -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding DraftFailed, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Text.SectionHeading}"
                       HorizontalAlignment="Center"
                       Text="{Binding DraftFailedMessage}" />
            <Button Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Button.Secondary}"
                    Content="Retry"
                    Command="{Binding RetryDraftCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasDraft, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Problem" />
                <TextBox Style="{StaticResource Input.Multiline}"
                         Margin="0,6,0,16"
                         Text="{Binding Problem, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Problem" />

                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Steps" />
                <ItemsControl x:Name="StepList" ItemsSource="{Binding Steps}" Margin="0,6,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type review:StepRow}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- The ⚠ rule down the left edge. One of three signals, not the signal. -->
                                <Border Grid.Column="0"
                                        Width="3"
                                        Margin="0,0,10,0"
                                        CornerRadius="2"
                                        Background="{DynamicResource Brush.confidence.low}"
                                        Visibility="{Binding NeedsVerification, Converter={StaticResource Visible}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBox Style="{StaticResource Input.Multiline}"
                                             KeyDown="OnStepKeyDown"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Step text" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- Glyph, word and rule: readable with no colour at all (Spec §7). -->
                                        <ContentControl Style="{StaticResource Badge.Confidence}"
                                                        Margin="0,0,6,0"
                                                        Content="⚠ Inferred"
                                                        ToolTip="{Binding VerificationTooltip}"
                                                        AutomationProperties.HelpText="{Binding VerificationTooltip}"
                                                        Visibility="{Binding NeedsVerification, Converter={StaticResource Visible}}" />

                                        <ItemsControl ItemsSource="{Binding Frames}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Pill.Control}"
                                                            Margin="0,0,6,0"
                                                            Content="{Binding Label}"
                                                            Tag="{Binding Id}"
                                                            Click="OnFrameChip" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Text.Mono}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.text.muted}"
                                               Text="{Binding Quote}"
                                               Visibility="{Binding HasQuote, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Result" />
                <TextBox Style="{StaticResource Input.Multiline}"
                         Margin="0,6,0,16"
                         Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Result" />

                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Follow-ups" />
                <TextBox Style="{StaticResource Input.Multiline}"
                         Margin="0,6,0,0"
                         Text="{Binding FollowUps, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Follow-ups, one per line" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: the save indicator, what is left to check, and the chords that apply to this pane.
             Spec §5 S3 puts the map where it is used rather than only in the ? sheet. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource Text.Muted}"
                       Text="{Binding SaveLabel}"
                       AutomationProperties.Name="Save status"
                       AutomationProperties.LiveSetting="Polite" />

            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       Style="{StaticResource Text.Muted}"
                       Text="{Binding UnverifiedLabel}" />

            <TextBlock Grid.Column="2"
                       Style="{StaticResource Text.Muted}"
                       FontSize="{DynamicResource Size.xs}"
                       Text="Alt+C confirm · Alt+↑↓ reorder · Ctrl+S save" />
        </Grid>
    </Grid>
</UserControl>
