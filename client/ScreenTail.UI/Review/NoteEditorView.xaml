<UserControl x:Class="ScreenTail.UI.Review.NoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenTail.UI.Controls"
             xmlns:review="clr-namespace:ScreenTail.UI.Review"
             Background="Transparent"
             AutomationProperties.Name="Note">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A section's name above its field: the pane's own hierarchy, a step quieter than its title. -->
        <Style x:Key="Note.Section" BasedOn="{StaticResource Text.Label}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The pane's title, like the other two. -->
        <TextBlock Grid.Row="0"
                   Margin="20,18,20,12"
                   Style="{StaticResource Text.SectionHeading}"
                   Text="Note" />

        <!-- Banners. Spec §7: never colour alone, so each carries a glyph and the kind as a word. -->
        <controls:Repeater Grid.Row="1" Margin="20,0,20,4" ItemsSource="{Binding Banners}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" controls:LiveRegion.Setting="Polite">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Banner.Info}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.bg.warning}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.paused}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- A Grid, not a horizontal StackPanel: a StackPanel measures its children with
                             infinite width, so TextWrapping never fires and the sentence is cut off at the
                             pane edge mid-word. The first version hid that behind MaxWidth="420", which is
                             a magic number that is wrong at every other pane width. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Text.Body}"
                                       Text="{Binding Glyph}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Text.Label}"
                                           Text="{Binding Kind}" />
                                <TextBlock Style="{StaticResource Text.Body}"
                                           TextWrapping="Wrap"
                                           Text="{Binding Text}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </controls:Repeater>

        <!-- v0.4.1 Q4: a failed draft says so and offers Retry. Writing a note by hand is v1.1, so there is
             no editor to fall back to, and an empty one would look like a note nobody wrote. -->
        <StackPanel Grid.Row="2"
                    Margin="32,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding DraftFailed, Converter={StaticResource Visible}}">
            <Border Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.bg.danger}"
                    CornerRadius="28">
                <controls:Glyph Style="{StaticResource EmptyState.Icon}"
                           Foreground="{DynamicResource Brush.state.danger}"
                           Text="&#xE7BA;" />
            </Border>
            <TextBlock Margin="0,16,0,0"
                       Style="{StaticResource Text.SectionHeading}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="{Binding DraftFailedMessage}" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="Your screenshots and transcript are saved." />
            <Button Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Button.Primary}"
                    Content="Retry"
                    Command="{Binding RetryDraftCommand}" />
        </StackPanel>

        <!-- ST-013: a draft queued for the backend is on its way, not failed, so there is no Retry. The
             failed pane's shape in a calm tone: the content row, under the title and the banners. -->
        <StackPanel Grid.Row="2"
                    Margin="32,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding DraftPending, Converter={StaticResource Visible}}">
            <Border Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.bg.selected}"
                    CornerRadius="28">
                <controls:Glyph Style="{StaticResource EmptyState.Icon}"
                           Foreground="{DynamicResource Brush.accent.primary}"
                           Text="&#xE895;" />
            </Border>
            <TextBlock Margin="0,16,0,0"
                       Style="{StaticResource Text.SectionHeading}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       controls:LiveRegion.Setting="Polite"
                       Text="{Binding DraftPendingMessage}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      Padding="20,4,14,8"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasDraft, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Note.Section}" Text="Problem" />
                <TextBox Style="{StaticResource Input.Multiline}"
                         Margin="0,0,0,20"
                         Text="{Binding Problem, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Problem" />

                <TextBlock Style="{StaticResource Note.Section}" Text="Steps" />
                <controls:Repeater x:Name="StepList" ItemsSource="{Binding Steps}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type review:StepRow}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <!-- Reserved whether or not the rule is drawn. With Auto the column
                                         collapses when the marker clears, so pressing Alt+C slid the step
                                         thirteen pixels left and left it out of line with its neighbours. -->
                                    <ColumnDefinition Width="11" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- The ⚠ rule down the left edge. One of three signals, not the signal. -->
                                <Border Grid.Column="0"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource Brush.confidence.low}"
                                        Visibility="{Binding NeedsVerification, Converter={StaticResource Visible}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBox Style="{StaticResource Input.Multiline}"
                                             PreviewKeyDown="OnStepKeyDown"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Step text" />

                                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <!-- Glyph, word and rule: readable with no colour at all (Spec §7). -->
                                        <ContentControl Style="{StaticResource Badge.Confidence}"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Content="⚠ Inferred"
                                                        ToolTip="{Binding VerificationTooltip}"
                                                        AutomationProperties.HelpText="{Binding VerificationTooltip}"
                                                        Visibility="{Binding NeedsVerification, Converter={StaticResource Visible}}" />

                                        <controls:Repeater ItemsSource="{Binding Frames}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <!-- The chip selects its frame in the strip through the note's
                                                     ShowFrameCommand, which ReviewViewModel hands to the strip (T-165). -->
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Chip}"
                                                            Margin="0,0,6,0"
                                                            Content="{Binding Label}"
                                                            Tag="{Binding Id}"
                                                            Command="{Binding DataContext.ShowFrameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:Repeater>
                                    </WrapPanel>

                                    <!-- What was said, set as a quotation: a rule at the left and the
                                         monospace face, so it never reads as part of the step. -->
                                    <Border Margin="2,8,0,0"
                                            Padding="10,0,0,0"
                                            BorderBrush="{DynamicResource Brush.border.strong}"
                                            BorderThickness="2,0,0,0"
                                            Visibility="{Binding HasQuote, Converter={StaticResource Visible}}">
                                        <TextBlock Style="{StaticResource Text.Mono}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.text.muted}"
                                                   Text="{Binding Quote}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>

                <TextBlock Style="{StaticResource Note.Section}" Text="Result" />
                <TextBox Style="{StaticResource Input.Multiline}"
                         Margin="0,0,0,20"
                         Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Result" />

                <TextBlock Style="{StaticResource Note.Section}" Text="Follow-ups" />
                <TextBox Style="{StaticResource Input.Multiline}"
                         Margin="0,0,0,4"
                         Text="{Binding FollowUps, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Follow-ups, one per line" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: the save indicator, what is left to check, and the chords that apply to this pane.
             Spec §5 S3 puts the map where it is used rather than only in the ? sheet. -->
        <Border Grid.Row="3"
                Padding="20,10"
                BorderBrush="{DynamicResource Brush.border.subtle}"
                BorderThickness="0,1,0,0">
            <!-- Two lines: what is left to do, then the chords. Side by side they wrapped into each
                 other at the pane's usual width. -->
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.text.secondary}"
                               Text="{Binding SaveLabel}"
                               AutomationProperties.Name="{Binding SaveLabel}"
                               controls:LiveRegion.Setting="Polite">
                        <!-- Gone when there is nothing to say: an empty, zero-sized text is an element a screen
                             reader finds with nothing in it, and Accessibility Insights fails it (ST-084). -->
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource Text.Muted}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Spaced from the save label only when there is one, so it never starts indented. -->
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding UnverifiedLabel}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource Text.Muted}" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
                                <Setter Property="Margin" Value="12,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveLabel}" Value="">
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SaveLabel}" Value="{x:Null}">
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Text.Muted}"
                           FontSize="{DynamicResource Size.xs}"
                           Text="Alt+C confirm · Alt+↑↓ reorder · Ctrl+S save" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
