<UserControl x:Class="ScreenTail.UI.Review.ReviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="clr-namespace:ScreenTail.UI.Review"
             xmlns:publish="clr-namespace:ScreenTail.UI.Review.Publish"
             xmlns:timeline="clr-namespace:ScreenTail.UI.Review.Timeline"
             AutomationProperties.Name="Review">
    <UserControl.InputBindings>
        <!-- Spec §5 S3: Ctrl+Enter publishes. The panel refuses when blocked, whatever pressed it. -->
        <KeyBinding Modifiers="Ctrl" Key="Return" Command="{Binding Publish.PublishCommand}" />
        <!-- Alt+T opens and closes the timeline and transcript panel (ST-076). -->
        <KeyBinding Modifiers="Alt" Key="T" Command="{Binding Timeline.ToggleCommand}" />
    </UserControl.InputBindings>
    <!-- Spec §5 S3: three panes side by side, each a card on the window, the note widest, the publish pane
         a fixed column on the right with its button at the bottom, and the timeline row (ST-076) below all
         three. Star widths, so the three still fit at the 1024 px minimum window: fixed widths of 440 and
         320 pushed the publish pane off the right edge there. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <timeline:TimelineView Grid.Row="1" Margin="0,12,0,0" DataContext="{Binding Timeline}" />

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="4*" MinWidth="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Pane}">
                <review:NoteEditorView x:Name="Note" DataContext="{Binding Note}" />
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource SplitPane.Splitter}"
                          AutomationProperties.Name="Resize the note pane" />

            <Border Grid.Column="2" Style="{StaticResource Pane}">
                <review:FilmstripView DataContext="{Binding Strip}" />
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource SplitPane.Splitter}"
                          AutomationProperties.Name="Resize the publish pane" />

            <Border Grid.Column="4" Style="{StaticResource Pane}">
                <publish:PublishPane DataContext="{Binding Publish}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
