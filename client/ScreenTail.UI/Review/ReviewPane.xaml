<UserControl x:Class="ScreenTail.UI.Review.ReviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="clr-namespace:ScreenTail.UI.Review"
             xmlns:publish="clr-namespace:ScreenTail.UI.Review.Publish"
             xmlns:timeline="clr-namespace:ScreenTail.UI.Review.Timeline"
             AutomationProperties.Name="Review">
    <UserControl.InputBindings>
        <!-- Spec §5 S3: Ctrl+Enter publishes. The panel refuses when blocked, whatever pressed it. -->
        <KeyBinding Modifiers="Ctrl" Key="Return" Command="{Binding Publish.PublishCommand}" />
        <!-- Alt+T opens and closes the timeline and transcript panel (ST-076). -->
        <KeyBinding Modifiers="Alt" Key="T" Command="{Binding Timeline.ToggleCommand}" />
    </UserControl.InputBindings>
    <!-- Spec §5 S3: the note pane at the width the harness has always rendered it, the filmstrip taking
         what is left, the publish pane on the right, and the timeline row (ST-076) below all three. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <timeline:TimelineView Grid.Row="1" DataContext="{Binding Timeline}" />

        <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" MinWidth="360" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="320" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <review:NoteEditorView Grid.Column="0" x:Name="Note" DataContext="{Binding Note}" FrameRequested="OnFrameRequested" />

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource Brush.border.subtle}"
                      AutomationProperties.Name="Resize the note pane" />

        <review:FilmstripView Grid.Column="2" DataContext="{Binding Strip}" />

        <GridSplitter Grid.Column="3"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource Brush.border.subtle}"
                      AutomationProperties.Name="Resize the publish pane" />

        <publish:PublishPane Grid.Column="4" DataContext="{Binding Publish}" />
        </Grid>
    </Grid>
</UserControl>
