<UserControl x:Class="ScreenTail.UI.Review.ReviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="clr-namespace:ScreenTail.UI.Review"
             xmlns:publish="clr-namespace:ScreenTail.UI.Review.Publish"
             xmlns:timeline="clr-namespace:ScreenTail.UI.Review.Timeline"
             AutomationProperties.Name="Review">
    <UserControl.InputBindings>
        <!-- Spec §5 S3: Ctrl+Enter publishes. The panel refuses when blocked, whatever pressed it. -->
        <KeyBinding Modifiers="Ctrl" Key="Return" Command="{Binding Publish.PublishCommand}" />
        <!-- Alt+T opens and closes the timeline and transcript panel (ST-076). -->
        <KeyBinding Modifiers="Alt" Key="T" Command="{Binding Timeline.ToggleCommand}" />
        <!-- Ctrl+S saves the note now (Spec §5 S3). The footer said so and nothing was bound (ST-084). -->
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding Note.SaveNowCommand}" />
    </UserControl.InputBindings>
    <!-- Spec §5 S3: three panes side by side, each a card on the window, the note widest, the publish pane
         a fixed column on the right with its button at the bottom, and the timeline row (ST-076) below all
         three. Star widths, so the three still fit at the 1024 px minimum window: fixed widths of 440 and
         320 pushed the publish pane off the right edge there. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Spec §5 S3's header: the session's title, then Discard on the right, a ghost button that turns
             danger on hover and on keyboard focus, and opens the typed DISCARD confirmation. Why a discard
             did not happen is said beside it, never in a dialog, and read out as it changes. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.ScreenTitle}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Text="{Binding Title}" />

            <TextBlock Grid.Column="1"
                       Margin="16,0,12,0"
                       MaxWidth="{DynamicResource Layout.content-max-width}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Error}"
                       Visibility="{Binding Note.DiscardFailed, Converter={StaticResource Visible}}"
                       Text="{Binding Note.DiscardError}"
                       AutomationProperties.LiveSetting="Assertive" />

            <Button Grid.Column="2"
                    Style="{StaticResource Button.GhostDanger}"
                    Content="Discard"
                    Command="{Binding Note.DiscardCommand}"
                    ToolTip="Discard this session. You will be asked to type DISCARD."
                    AutomationProperties.Name="Discard this session"
                    AutomationProperties.HelpText="Deletes the screenshots, transcript and note from this device. You will be asked to type DISCARD." />
        </Grid>

        <!-- The splitters sit in the 12 px gaps but are 28 px wide (Spec §7's smallest target), reaching 8 px
             over each pane's edge, above it, where there is no control to cover (ST-084). Above means a
             higher ZIndex, which also moves them to the end of the order Tab walks the children in, so the
             order is said here: note, splitter, screenshots, splitter, publish, left to right. -->
        <Grid Grid.Row="1" KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="4*" MinWidth="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Pane}" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
                <review:NoteEditorView x:Name="Note" DataContext="{Binding Note}" />
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="28"
                          Margin="-8,0"
                          Panel.ZIndex="1"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource SplitPane.Splitter}"
                          KeyboardNavigation.TabIndex="2"
                          AutomationProperties.Name="Resize the note pane" />

            <Border Grid.Column="2" Style="{StaticResource Pane}" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="3">
                <review:FilmstripView x:Name="Strip" DataContext="{Binding Strip}" />
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="28"
                          Margin="-8,0"
                          Panel.ZIndex="1"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource SplitPane.Splitter}"
                          KeyboardNavigation.TabIndex="4"
                          AutomationProperties.Name="Resize the publish pane" />

            <Border Grid.Column="4" Style="{StaticResource Pane}" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="5">
                <publish:PublishPane x:Name="Publish" DataContext="{Binding Publish}" />
            </Border>
        </Grid>

        <!-- After the panes in the tree, not before them: Tab follows the tree, and the timeline is the
             bottom row, so it comes last (ST-084 found it first, between Discard and the note). -->
        <timeline:TimelineView Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding Timeline}" />
    </Grid>
</UserControl>
