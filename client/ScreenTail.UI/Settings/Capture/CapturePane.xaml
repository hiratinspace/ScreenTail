<UserControl x:Class="ScreenTail.UI.Settings.Capture.CapturePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Capture">
    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">

        <!-- Remote tools: a toggle per tool the registry knows. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Remote tools" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="A session starts when one of these takes focus. Switch one off and its windows are not captured." />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,0,0,4" Content="{Binding DisplayName}" IsChecked="{Binding Enabled}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Capture scope, with the inline warning and a confirmation before "All windows" saves (INV-5). -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Capture scope" />
                <RadioButton Margin="0,8,0,0" GroupName="Scope" Content="Remote-tool windows and admin tools (Recommended)" IsChecked="{Binding RemoteToolsOnly}" IsEnabled="{Binding ScopeEditable}" />
                <RadioButton Margin="0,4,0,0" GroupName="Scope" Content="All windows during a session" IsChecked="{Binding AllWindows}" IsEnabled="{Binding ScopeEditable}" />
                <Border Style="{StaticResource Banner.Warning}" Margin="0,8,0,0" Visibility="{Binding ScopeWarningVisibility}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding ScopeWarning}" AutomationProperties.LiveSetting="Assertive" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Content="I understand, capture all windows" Command="{Binding ConfirmAllWindowsCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Auto-start and the grace period. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Starting and stopping" />
                <CheckBox Margin="0,8,0,0" Content="Start a session by itself when a remote tool takes focus" IsChecked="{Binding AutoStart}" />
                <TextBlock Margin="0,14,0,4" Style="{StaticResource Text.Label}" Text="Stop after the remote tool has been gone for" />
                <StackPanel Orientation="Horizontal">
                    <Slider Width="280" Minimum="30" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding GraceSeconds}" AutomationProperties.Name="Grace period in seconds" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding GraceSeconds}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="seconds" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Hotkeys, checked as typed; a clash names an alternative inline (ST-029). -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Hotkeys" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding Label}" />
                                <TextBox Grid.Column="1" Style="{StaticResource Input.Default}" FontFamily="{DynamicResource Font.mono}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" />
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Text="{Binding Problem}" Visibility="{Binding ProblemVisibility}" AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Screenshots and the microphone. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="Screenshots" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="How much the screen has to change for a screenshot between clicks" />
                <ComboBox Margin="0,8,0,0" Width="180" HorizontalAlignment="Left" ItemsSource="{Binding Sensitivities}" SelectedItem="{Binding Sensitivity}" AutomationProperties.Name="Scene-change sensitivity" />

                <!-- ST-080 AC3: the device and its live level. The level is read only while this card is
                     on screen with the window in front (the code-behind says when); nothing is recorded. -->
                <StackPanel x:Name="MicrophoneCard">
                    <TextBlock Margin="0,24,0,0" Style="{StaticResource Text.SectionHeading}" Text="Microphone" />
                    <TextBlock Margin="0,8,0,6" Style="{StaticResource Text.Label}" Text="Device" />
                    <ComboBox Width="360" HorizontalAlignment="Left" ItemsSource="{Binding MicrophoneOptions}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Label" AutomationProperties.Name="Microphone">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding MicrophoneNote}" Visibility="{Binding MicrophoneNoteVisibility}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Level" />
                        <ProgressBar Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Meter.Level}" Value="{Binding MicrophoneLevel, Mode=OneWay}" AutomationProperties.Name="Microphone level" AutomationProperties.HelpText="{Binding MicrophoneLevelStatus}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding MicrophoneLevelStatus}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding MicrophoneApplies, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Margin="0,14,0,6" Style="{StaticResource Text.Label}" Text="Speech model" />
                <ComboBox Width="360" HorizontalAlignment="Left" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" AutomationProperties.Name="Speech model">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="AutomationProperties.Name">
                                <Setter.Value>
                                    <MultiBinding StringFormat="{}{0}, {1}">
                                        <Binding Path="Name" />
                                        <Binding Path="Hint" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Name}" />
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.Muted}" Text="{Binding Hint}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding AppliesAtNextStart}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <CheckBox Content="Start ScreenTail when I sign in to Windows" IsChecked="{Binding StartUiAtLogin}" />
        </Border>

        <Button Margin="0,4,0,0" MinWidth="96" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Text="{Binding Problem}" Visibility="{Binding ProblemVisibility}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Margin="0,6,0,12" Style="{StaticResource Text.Muted}" Text="{Binding Saved}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
