<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Per-user capture service host: Windows adapters (hooks, UIA, capture, DPAPI, pipes) over ScreenTail.Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Exe for now so `dotnet run` shows logs; ST-004 decides how the per-user service is hosted. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>ScreenTail.Service</RootNamespace>
    <AssemblyName>ScreenTail.Service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- ST-025: GDI+ for the downscale and JPEG encode. ADR-0001 flags this path as over budget; the
         laptop's per-stage timings decide whether it is replaced by WIC or Windows.Graphics.Capture. -->
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenTail.Core\ScreenTail.Core.csproj" />
    <ProjectReference Include="..\ScreenTail.Shared\ScreenTail.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows tests exercise the capability probe against real Windows (ST-021). -->
    <InternalsVisibleTo Include="ScreenTail.Tests.Windows" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\shared\registry\remote-tools.json" Link="Registry\remote-tools.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
