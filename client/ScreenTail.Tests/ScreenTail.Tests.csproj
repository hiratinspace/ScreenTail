<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the platform-neutral projects; runs on any OS (ADR-0002). Windows-bound tests go in
       ScreenTail.Tests.Windows once the first one exists. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ScreenTail.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenTail.Core\ScreenTail.Core.csproj" />
    <ProjectReference Include="..\ScreenTail.Shared\ScreenTail.Shared.csproj" />
  </ItemGroup>
</Project>
