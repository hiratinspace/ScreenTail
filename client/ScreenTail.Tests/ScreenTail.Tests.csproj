<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the platform-neutral projects; runs on any OS (ADR-0002). Windows-bound tests go in
       ScreenTail.Tests.Windows once the first one exists. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ScreenTail.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema and its examples are the single source; the tests read them from the output folder. -->
    <None Include="..\..\shared\schema\session.v1.json" Link="Schema\session.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\shared\schema\examples\**\*.json" LinkBase="Schema\examples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenTail.Core\ScreenTail.Core.csproj" />
    <ProjectReference Include="..\ScreenTail.Shared\ScreenTail.Shared.csproj" />
  </ItemGroup>
</Project>
