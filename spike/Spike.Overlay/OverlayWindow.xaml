<Window x:Class="ScreenTail.Spike.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTail.Spike.Overlay"
        Width="360"
        Height="44"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SourceInitialized="OnSourceInitialized">
    <!-- Magenta is a test marker the capture probe looks for, not the HUD design (ST-072 implements Spec §5 S2). -->
    <Border CornerRadius="22"
            Background="#FF00FF"
            BorderBrush="#33404F"
            BorderThickness="1"
            MouseLeftButtonDown="OnDragStart">
        <TextBlock x:Name="StatusText"
                   Margin="16,0"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI"
                   FontSize="13"
                   Foreground="Black" />
    </Border>
</Window>
